        background-color: #f3f2f1;
        margin-bottom: 30px;
    }

    .filter-content {
        padding: 20px;
    }

    .filter-heading {
        background-color: #b1b4b6;
        padding: 10px;
    }

    .users-list .govuk-link {
        text-decoration: none;
    }

    .column-full {
        overflow: hidden;
    }

    .responsive-img {
        max-width: 100%;
