@using Cddo.Data.Marketplace.Api.Dto.Responses.ManageUser
@using Cddo.Data.Marketplace.Logic.Services.Interfaces
@using Cddo.Data.Marketplace.UI.Controllers
@using Cddo.Data.Marketplace.UI.Pages.Shared 
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums;
@inject IManageOrganisationService _manageUserService
@inject IUserRoleService UserRoleService
@model MetadataReportsStats
@{
    Layout = "/Pages/Shared/_HeaderLayout.cshtml";
    ViewData["Title"] = "Metadata Stats Reports";

    var selectedOption = new { PublisherOrganisationId = 1, To = DateTime.Now, MinimumDuration = "1.00:00:00", MaximumDuration = "1.00:00:00" };

    var manageOrganisationRequest = new ManageOrganisationsRequest
            {
                PageNumber = 1,
                PageSize = int.MaxValue
            };
    var organisationList = await _manageUserService.GetManageOrganisationsAsync(manageOrganisationRequest);

    bool isAdministrator = await UserRoleService.IsUserRoleAdmin();

    bool isSystemAdministrator = await UserRoleService.IsUserRoleSystemAdmin();

    bool isSupplier = await UserRoleService.IsUserRoleSupplier();

    string organisationId = String.Empty;
    var userOrganisation = new OrganisationDetail();

    if (!isSystemAdministrator)
    {
        var user = await UserRoleService.GetUserProfileAsync();
        organisationId = user.Organisation!.OrganisationId.ToString();
        userOrganisation = new OrganisationDetail()
                {
                    OrganisationName = user.Organisation!.OrganisationName,
                    OrganisationId = user.Organisation!.OrganisationId
                };
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {


            const data = [
                { status: 'Submitted', count: @Model?.TotalPublished, color: 'rgba(234, 67, 53, 0.7)' }, // Red
                { status: 'Approved', count: @Model?.TotalPublished, color: 'rgba(251, 188, 5, 0.7)' }, // Yellow
                { status: 'Rejected', count: @Model?.TotalPublished, color: 'rgba(15, 157, 88, 0.7)' }, // Green
                { status: 'Cancelled', count: @Model?.TotalPublished, color: 'rgba(223, 227, 236, 0.7)' }, // Light Grey
                { status: 'Returned with comments', count: @Model?.TotalPublished, color: 'rgba(255, 165, 0, 0.7)' } // Orange
            ];

            if (Boolean(@isSystemAdministrator.ToString().ToLower())) {
                data.push({ status: 'Draft', count: @Model?.TotalDraft, color: 'rgba(66, 133, 244, 0.7)' }); // Blue)
            };

            const datasets = data.map(item => ({
                label: item.status,
                data: [item.count],
                backgroundColor: item.color,
                borderColor: item.color.replace('0.7', '1'),
                borderWidth: 1
            }));

            const ctx = document.getElementById('dataShareRequestChart').getContext('2d');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Status'],
                    datasets: datasets
                },
                options: {
                    scales: {
                        x: {
                            stacked: true,
                            title: {
                                display: true,
                                text: 'Status'
                            }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Count'
                            },
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        legend: {
                            display: true
                        }
                    }
                }
            });
        });
    </script>
}

