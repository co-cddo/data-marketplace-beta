                    <div class="dataset-result">
                        <div class="govuk-table-wrapper">
                            @if (Model?.CatalogReportsDataItems != null && Model?.CatalogReportsDataItems.Count > 0)
                            {
                                <table class="govuk-table">
                                    <thead class="govuk-table__head">
                                        <tr class="govuk-table__row">
                                            @if (Model.CatalogReportsDataItems.FirstOrDefault()?.CatalogReportsDataItemFields != null)
                                            {
                                                @foreach (var field in Model.CatalogReportsDataItems.First().CatalogReportsDataItemFields)
                                                {
                                                    <th class="govuk-table__header">@field.Field</th>
                                                }
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="govuk-table__body">
                                        @{
                                            foreach (var item in Model.CatalogReportsDataItems)
                                            {

                                                <tr class="govuk-table__row">
                                                    @foreach (var field in item.CatalogReportsDataItemFields)
                                                    {
                                                        if (field != null)
                                                        {
