                                                        }
                                                        else
                                                        {
                                                            <td class="govuk-table__cell">N/A</td>
                                                        }

                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>

                                </table>
                            }
                            else
                            {
                                <p class="govuk-body">No data available</p>
                            }
                        </div>
