                                </label>
                                <div class="govuk-input__wrapper">
                                    <select class="govuk-input" id="pageSize" aria-label="Select results per page" name="@nameof(QueryCatalogReportsDataRequestFilter.PageSize)" style="min-width:2.6em;">
                                        @foreach (var pageSizeOption in new[] { 10, 20, 50, 100 })
                                        {
                                            <option selected="@(ViewBag.PageSize==pageSizeOption)" value="@pageSizeOption">@pageSizeOption</option>
                                        }
                                    </select>
                                    <button class="govuk-button govuk-button--secondary govuk-input__suffix" type="submit" style="max-width:5em;">
