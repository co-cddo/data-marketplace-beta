@using Agm.Catalog.DotNet.Dto.Models.CatalogData
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Cddo.Data.Marketplace.Api.Dto.Requests.Reports
@using Cddo.Data.Marketplace.Api.Dto.Responses.Reports
@using Cddo.Data.Marketplace.UI.Controllers
@using Cddo.Data.Marketplace.UI.Services.Interfaces
@using System.Reflection
@using System.ComponentModel
@using Newtonsoft.Json
@inject ICatalogDataService _catalogDataService
@model QueryCatalogReportsDataResponse
@{
    ViewData["Title"] = "Metadata Report";

    var organisations = Model.SelectableOrganisations.OrderBy(x => x);
    var stringFyOrganisations = JsonConvert.SerializeObject(organisations);

    const int maxMiddlePages = 3;

    var totalResults = Model?.TotalNumberOfMatchedRecords ?? 0;
    var currentPage = ViewBag.PageNumber;
    var totalPages = (int)Math.Ceiling((double)totalResults / ViewBag.PageSize);

    currentPage = Math.Max(1, Math.Min(currentPage, totalPages));

    var middleStart = Math.Max(1, currentPage - maxMiddlePages / 2);
    var middleEnd = Math.Min(totalPages, middleStart + maxMiddlePages - 1);
    middleStart = Math.Max(1, middleEnd - maxMiddlePages + 1);

    if (totalPages <= maxMiddlePages)
    {
        middleStart = 1;
        middleEnd = totalPages;
    }

    if (currentPage < middleStart)
    {
        currentPage = middleStart;
    }
    else if (currentPage > middleEnd)
    {
        currentPage = middleEnd;
    }
}

@functions {
    public static string PrettifyString(string? input)
    {
        if (input == null)
        {
            return "";
        }

        return string.Join(" ", input.Split('-').Select(w => char.ToUpper(w[0]) + w.Substring(1)));
    }

    public static string GetEnumDescription(Enum value)
    {
        FieldInfo field = value.GetType().GetField(value.ToString());
        if (field != null)
        {
            DescriptionAttribute attribute = (DescriptionAttribute)Attribute.GetCustomAttribute(field, typeof(DescriptionAttribute));
            if (attribute != null)
            {
                return attribute.Description;
            }
        }
        return value.ToString();
    }
}

