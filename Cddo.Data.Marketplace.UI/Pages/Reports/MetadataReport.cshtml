                    @if (@Model?.TotalNumberOfMatchedRecords > 0)
                    {
                        <nav class="govuk-pagination" role="navigation" aria-label="Pagination">
                            @if (currentPage != 1)
                            {
                                <div class="govuk-pagination__prev">
                                    <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(QueryCatalogReportsDataRequestFilter.PageNumber)" value="@(currentPage - 1)" rel="prev">
                                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                            <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                                        </svg>
                                        <span class="govuk-pagination__link-title">
                                            <strong>Previous</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
                                    </button>
                                </div>
                            }
                            <ul class="govuk-pagination__list">
                                @if (middleStart > 1)
                                {
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(QueryCatalogReportsDataRequestFilter.PageNumber)" value="1">1</button>
                                    </li>
                                    @if (middleStart > 2)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                }

                                @for (int i = middleStart; i <= middleEnd; i++)
                                {
                                    <li class="govuk-pagination__item @(i == currentPage ? "govuk-pagination__item--current" : "")">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(QueryCatalogReportsDataRequestFilter.PageNumber)" value="@i">@i</button>
                                    </li>
                                }

                                @if (middleEnd < totalPages)
                                {
                                    @if (middleEnd < totalPages - 1)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(QueryCatalogReportsDataRequestFilter.PageNumber)" value="@totalPages">@totalPages</button>
                                    </li>
                                }
                            </ul>

                            @if (currentPage != totalPages)
                            {
                                <div class="govuk-pagination__next">
                                    <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(QueryCatalogReportsDataRequestFilter.PageNumber)" value="@(currentPage + 1)" rel="next">
                                        <span class="govuk-pagination__link-title">
                                            <strong>Next</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
