@page
@model Cddo.Data.Marketplace.UI.Pages.Error._NotAllowedYetModel
@{
    ViewData["Title"] = "Not Allowed Yet";
}

<div class="govuk-width-container">
    <div class="govuk-main-wrapper govuk-main-wrapper--l" >
        <h1 class="govuk-heading-l">Not Enrolled Yet</h1>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <p class="govuk-body">
                    Unfortunately your organisation is not enrolled yet to use the Cabinet Office Data Marketplace.
                </p>
                <p class="govuk-body">
                    You can still learn more about the Data Markertplace through our learn and guide section.<br /><br />
                    We are progressivley on boarding departments. <br /><br />
                    If you wish to contact the team please use the feedback form in the support section.
                </p>
            </div>
        </div>
    </div>
</div>