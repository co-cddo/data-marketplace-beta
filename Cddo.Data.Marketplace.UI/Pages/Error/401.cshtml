@page
@model Cddo.Data.Marketplace.UI.Pages.Error.Error401Model
@{
    ViewData["Title"] = "Error - 401";
}

<div class="govuk-width-container">
    <div class="govuk-main-wrapper govuk-main-wrapper--l">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-l">Not authorised</h1>
                <p class="govuk-body">
                    If you typed the web address, check it is correct and that you are logged in to the service.
                </p>
                <p class="govuk-body">
                    If you pasted the web address, check you copied the entire address.
                </p>
            </div>
        </div>
    </div>
</div>