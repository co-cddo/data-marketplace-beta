@using Cddo.Data.Marketplace.UI.Controllers
@model Cddo.Data.Marketplace.UI.Pages.DataDescription.DataDescriptionDashboardModel
@{
    ViewData["Title"] = "Data Description Dashboard";
}
@section Styles
{
    <link rel="stylesheet" href="~/css/data-description-dashboard.min.css" />
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper ">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds govuk-!-margin-bottom-6">
            <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">
                Data descriptions published by the @ViewBag.OrganisationName
            </h1>
            <p class="govuk-body">
                Manage your organisation’s data descriptions (also known as metadata records).
                Every metadata record must have a description of the data set to help other users find it.
            </p>
            <p class="govuk-body">
                You can search for and edit any description that your organisation has already published.
            </p>

            <a asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddNewDataDescription)" class="govuk-button" data-module="govuk-button">
                Add new data description
            </a>
            <p class="govuk-body">
                <a asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssetsByUser)" class="govuk-link">Find your data descriptions</a>
            </p>
        </div>
    </div>
</div>