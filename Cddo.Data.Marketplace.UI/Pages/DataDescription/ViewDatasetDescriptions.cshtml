@using Agm.Catalog.DotNet.Dto.Models.DataAssets
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Agm.Catalog.DotNet.Dto.Requests.DataAssets
@using Agm.Catalog.DotNet.Dto.Responses.DataAssets
@using Cddo.Data.Marketplace.UI.Configuration
@using Cddo.Data.Marketplace.UI.Services.Interfaces
@using Cddo.Data.Marketplace.UI.Controllers
@inject ICatalogDataService _catalogDataService
@model GetCddoDataAssetsResponse
@{
    ViewData["Title"] = "View data set description";

    var topics = await _catalogDataService.GetCddoTopicsAsync();

    const int maxMiddlePages = 3;

    var totalResults = Model?.TotalNumberOfMatchingCddoDataAssets ?? 0;
    var currentPage = ViewBag.PageNumber;
    var totalPages = (int)Math.Ceiling((double)totalResults / ViewBag.NumberOfRecords);

    currentPage = Math.Max(1, Math.Min(currentPage, totalPages));

    var middleStart = Math.Max(1, currentPage - maxMiddlePages / 2);
    var middleEnd = Math.Min(totalPages, middleStart + maxMiddlePages - 1);
    middleStart = Math.Max(1, middleEnd - maxMiddlePages + 1);

    if (totalPages <= maxMiddlePages)
    {
        middleStart = 1;
        middleEnd = totalPages;
    }

    if (currentPage < middleStart)
    {
        currentPage = middleStart;
    }
    else if (currentPage > middleEnd)
    {
        currentPage = middleEnd;
    }

    var isAuthenticated = User.Identity.IsAuthenticated;
}

@section Styles
{
    <link rel="stylesheet" href="~/css/dataset-results.min.css" />
}

@functions {
    public static string PrettifyString(string? input)
    {
        if (input == null)
        {
            return "";
        }

        return string.Join(" ", input.Split('-').Select(w => char.ToUpper(w[0]) + w.Substring(1)));
    }
    public static string RenderDescription(string? description)
    {
        if (!string.IsNullOrEmpty(description) && description.Length > 160)
        {
            return $"{description[..160]}...";
        }
        else
        {
            return description ?? string.Empty;
        }
    }
}

<div class="govuk-width-container">
    <a class="govuk-back-link" href="javascript:window.history.back()">Back</a>
    <div class="govuk-main-wrapper">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">
            Find a listing
        </h1>
        <form asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssetsByUser)" method="get">
            <div class="govuk-grid-row mb-5">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-form-group mb-2 search-input">
                        <label for="SearchText" class="search__label govuk-label visually-hidden">Search the Data Catalogue</label>

                        <div class="govuk-input__wrapper" style="position: relative;">
                            <input class="govuk-input govuk-input--width-40" id="SearchText" name="@nameof(GetCddoDataAssetsRequest.SearchText)" type="text" list="searchList" autocomplete="off" value="@ViewBag.SearchText">
                            <button title="datasetSearchBtn" class="search-button" type="submit" aria-label="Search for datasets" enterkeyhint="search">
                                <svg class="search-button__icon" width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                                    <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
                                    <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line>
                                </svg>
                            </button>
                            <ul id="dataDescriptionsSearchList" class="suggestions"></ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-third">
                    <div class="accordion accordion-flush accordion-filter" id="accordionFlushFilter">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-asset">
                                <button class="accordion-button collapsed govuk-link " type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseAsset" aria-controls="flush-collapseAsset">
                                    Asset Types
                                </button>
                            </h2>
                            <div id="flush-collapseAsset" class="accordion-collapse collapse" aria-labelledby="flush-asset" data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body">
                                    <div class="govuk-form-group">
                                        <fieldset class="govuk-fieldset">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m visually-hidden">
                                                <h1 class="govuk-fieldset__heading">
                                                    Asset Types
                                                </h1>
                                            </legend>
                                            <div class="govuk-checkboxes govuk-checkboxes--small filter-list" data-module="govuk-checkboxes">
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="dataSet" name="@nameof(GetCddoDataAssetsRequest.DataAssetTypes)" type="checkbox" value="@DataAssetType.DataSet" @(ViewBag?.DataAssetTypes?.Contains(DataAssetType.DataSet) ? "checked" : "")>
                                                    <label class="govuk-label govuk-checkboxes__label" for="dataSet">
                                                        Data Set
                                                    </label>
                                                </div>
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="dataService" name="@nameof(GetCddoDataAssetsRequest.DataAssetTypes)" type="checkbox" value="@DataAssetType.DataService" @(ViewBag?.DataAssetTypes?.Contains(DataAssetType.DataService) ? "checked" : "")>
                                                    <label class="govuk-label govuk-checkboxes__label" for="dataService">
                                                        Data Service
                                                    </label>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-status">
                                <button class="accordion-button collapsed govuk-link " type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseStatus" aria-controls="flush-collapseStatus">
                                    Status Types
                                </button>
                            </h2>
                            <div id="flush-collapseStatus" class="accordion-collapse collapse" aria-labelledby="flush-status" data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body">
                                    <div class="govuk-form-group">
                                        <fieldset class="govuk-fieldset">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m visually-hidden">
                                                <h1 class="govuk-fieldset__heading">
                                                    Status Types
                                                </h1>
                                            </legend>
                                            <div class="govuk-checkboxes govuk-checkboxes--small filter-list" data-module="govuk-checkboxes">
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="@DataAssetStatus.Draft" name="@nameof(GetCddoDataAssetsRequest.DataAssetStatuses)" type="checkbox" value="@DataAssetStatus.Draft" @(ViewBag?.DataAssetStatuses?.Contains(DataAssetStatus.Draft) ? "checked" : "")>
                                                    <label class="govuk-label govuk-checkboxes__label" for="@DataAssetStatus.Draft">
                                                        Draft
                                                    </label>
                                                </div>
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="@DataAssetStatus.Published" name="@nameof(GetCddoDataAssetsRequest.DataAssetStatuses)" type="checkbox" value="@DataAssetStatus.Published" @(ViewBag?.DataAssetStatuses?.Contains(DataAssetStatus.Published) ? "checked" : "")>
                                                    <label class="govuk-label govuk-checkboxes__label" for="@DataAssetStatus.Published">
                                                        Published
                                                    </label>
                                                </div>
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="@DataAssetStatus.Archived" name="@nameof(GetCddoDataAssetsRequest.DataAssetStatuses)" type="checkbox" value="@DataAssetStatus.Archived" @(ViewBag?.DataAssetStatuses?.Contains(DataAssetStatus.Archived) ? "checked" : "")>
                                                    <label class="govuk-label govuk-checkboxes__label" for="@DataAssetStatus.Archived">
                                                        Archived
                                                    </label>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="govuk-button-group">
                        <button type="submit" class="govuk-button" data-module="govuk-button">
                            Apply filter
                        </button>
                        <a class="govuk-link" href="GetCddoDataAssetsByUser">Clear all</a>
                    </div>
                </div>
                <div class="govuk-grid-column-two-thirds">
                    <h2 class="govuk-heading-s govuk-!-margin-bottom-2">@Model?.TotalNumberOfMatchingCddoDataAssets results</h2>
                    <hr />
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half">
                            <div class="govuk-form-group mb-0 d-inline-flex">
                                <label class="govuk-label" hidden for="pageSize">Sort by</label>
                                <div class="govuk-input__wrapper">
                                    <select class="govuk-select" name="sortOption" id="sortOption" aria-label="Sort by">
                                        <option value="@DataAssetsSortField.Title|@DataAssetsSortDirection.Ascending"
                                                selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.Title.ToString() &&
                                            Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Ascending.ToString())">
                                            Alphabetical A-Z
                                        </option>
                                        <option value="@DataAssetsSortField.Title|@DataAssetsSortDirection.Descending"
                                                selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.Title.ToString() &&
                                    Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Descending.ToString())">
                                            Alphabetical Z-A
                                        </option>
                                        <option value="@DataAssetsSortField.UpdatedOn|@DataAssetsSortDirection.Descending"
                                                selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.UpdatedOn.ToString() &&
                                    Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Descending.ToString())">
                                            Modified (newest)
                                        </option>
                                        <option value="@DataAssetsSortField.UpdatedOn|@DataAssetsSortDirection.Ascending"
                                                selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.UpdatedOn.ToString() &&
                                    Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Ascending.ToString())">
                                            Modified (oldest)
                                        </option>
                                        <option value="@DataAssetsSortField.Relevance|@DataAssetsSortDirection.Descending"
                                                selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.Relevance.ToString() &&
                                    Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Descending.ToString())">
                                            Relevance
                                        </option>
                                    </select>
                                    <button class="govuk-button govuk-button--secondary govuk-input__suffix">Sort</button>
                                </div>
                            </div>
                        </div>
                        <div class="govuk-grid-column-one-half">
                            <div class="govuk-form-group mb-0 d-inline-flex float-end">
                                    <label class="govuk-label"  for="pageSize" style="padding-right: 10px;padding-top: 7px;">
                                        Results Per Page
                                    </label>
                                <div class="govuk-input__wrapper">
                                    <select class="govuk-input" id="pageSize" aria-label="Select results per page" name="@nameof(GetCddoDataAssetsRequest.NumberOfRecords)" style="min-width:2em;">
                                        @foreach (var pageSizeOption in new[] { 10, 20, 50, 100 })
                                        {
                                            if (Convert.ToInt32(ViewData["NumberOfRecords"]) == pageSizeOption)
                                            {
                                                <option value="@pageSizeOption" selected>@pageSizeOption</option>
                                            }
                                            else
                                            {
                                                <option value="@pageSizeOption">@pageSizeOption</option>
                                            }
                                        }
                                    </select>
                                    <button class="govuk-button govuk-button--secondary govuk-input__suffix">
                                        Apply
                                         <span class="govuk-visually-hidden">
                                         results per page
                                         </span></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dataset-result">
                        <ul class="govuk-!-margin-bottom-5">
                            @if (@Model?.CddoDataAssets.Count > 0)
                            {
                                @foreach (var dataAsset in Model?.CddoDataAssets!)
                                {
                                    <li class="dataset-result__list">
                                        <div class="d-flex justify-content-between align-items-center mb-0">
                                            <h3 class="dataset-title govuk-heading-s mb-0">
                                                <a class="govuk-link" asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssetByUser)" asp-route-identifier="@dataAsset.Id">
                                                    @dataAsset.Title
                                                </a>
                                            </h3>
                                            @if (dataAsset?.DataAssetStatus != null)
                                            {
                                                <strong class="govuk-tag govuk-tag--blue">@dataAsset?.DataAssetStatus</strong>
                                            }
                                        </div>

                                        <p class="govuk-!-font-weight-bold govuk-hint govuk-!-font-size-16">
                                            <span class="govuk-visually-hidden">Organisation: </span>@dataAsset?.PublisherPrettified
                                        </p>
                                        <div>
                                            <strong class="govuk-tag govuk-tag--grey">@dataAsset?.DataAssetType</strong>
                                            @if (dataAsset!.ManifestationTypes.Any())
                                            {
                                                <span>|</span>
                                                foreach (var type in dataAsset.ManifestationTypes)
                                                {
                                                    <strong class="govuk-tag govuk-tag--grey">@type</strong>
                                                }
                                            }
                                        </div>

                                        <div class="govuk-!-margin-bottom-2 govuk-!-margin-top-2">
                                            <p class="govuk-body-s">
                                                @RenderDescription(dataAsset?.Description)
                                            </p>
                                            <p class="govuk-hint govuk-!-font-size-16">Last Updated: @dataAsset?.Modified.ToGDSHelperString()</p>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="dataset-result__list">
                                    <p class="govuk-body">No results found.</p>
                                </li>
                            }
                        </ul>

                    </div>
                    @if (@Model?.CddoDataAssets.Count > 0)
                    {
                        <nav class="govuk-pagination" role="navigation" aria-label="Pagination">
                            @if (currentPage != 1)
                            {
                                <div class="govuk-pagination__prev">
                                    <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(GetCddoDataAssetsRequest.PageNumber)" value="@(currentPage - 1)" rel="prev">
                                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                            <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                                        </svg>
                                        <span class="govuk-pagination__link-title">
                                            <strong>Previous</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
                                    </button>
                                </div>
                            }
                            <ul class="govuk-pagination__list">
                                @if (middleStart > 1)
                                {
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(GetCddoDataAssetsRequest.PageNumber)" value="1">1</button>
                                    </li>
                                    @if (middleStart > 2)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                }

                                @for (int i = middleStart; i <= middleEnd; i++)
                                {
                                    <li class="govuk-pagination__item @(i == currentPage ? "govuk-pagination__item--current" : "")">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(GetCddoDataAssetsRequest.PageNumber)" value="@i">@i</button>
                                    </li>
                                }

                                @if (middleEnd < totalPages)
                                {
                                    @if (middleEnd < totalPages - 1)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(GetCddoDataAssetsRequest.PageNumber)" value="@totalPages">@totalPages</button>
                                    </li>
                                }
                            </ul>

                            @if (currentPage != totalPages)
                            {
                                <div class="govuk-pagination__next">
                                    <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(GetCddoDataAssetsRequest.PageNumber)" value="@(currentPage + 1)" rel="next">
                                        <span class="govuk-pagination__link-title">
                                            <strong>Next</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
                                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                            <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </nav>
                    }
                </div>
            </div>
        </form>

        @section Scripts {
            <script asp-add-nonce="true">
                document.addEventListener("DOMContentLoaded", function () {
                    const searchInput = document.getElementById('SearchText');
                    const searchList = document.getElementById('dataDescriptionsSearchList');

                    // Set isAuthenticated based on server-side check
                    const isAuthenticated = @Json.Serialize(isAuthenticated);

                    searchInput.addEventListener('input', function (e) {
                        const searchTerm = e.target.value.trim().toLowerCase();
                        if (searchTerm.length === 0) {
                            searchList.innerHTML = '';
                            return;
                        }

                        if (!isAuthenticated) {
                            console.log('User is not logged in');
                            searchList.innerHTML = ''; // Clear the list if user is not logged in
                            return;
                        }

                        fetch(`/catalogData/GetSearchSuggestionsForOrganisationDataAssets?searchText=${encodeURIComponent(searchTerm)}`, {
                            credentials: 'include'
                        })
                            .then(response => {
                                if (response.redirected) {
                                    window.location.href = response.url;
                                    return;
                                }
                                if (!response.ok) {
                                    throw new Error('Network response was not ok');
                                }
                                return response.json();
                            })
                            .then(data => {
                                console.log('Fetched data:', data); // Log the response data
                                if (data.length === 0) {
                                    searchList.innerHTML = ''; // Clear the list if no results
                                    return;
                                }
                                const optionsHTML = data.map(item => `<li>${item}</li>`).join('');

                                console.log('adding to search list');
                                console.log(optionsHTML);
                                console.log(searchList);

                                searchList.innerHTML = optionsHTML;
                            })
                            .catch(error => {
                                console.error('Error fetching data:', error);
                                searchList.innerHTML = '';
                            });
                    });

                    // Optional: Add click event listener for suggestion items
                    searchList.addEventListener('click', function (e) {
                        if (e.target.tagName === 'LI') {
                            searchInput.value = e.target.textContent;
                            searchList.innerHTML = '';
                        }
                    });
                });
            </script>
        }



    </div>
</div>

