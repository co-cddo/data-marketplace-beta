@using Cddo.Data.Marketplace.Api.Dto.Requests.Catalog.Questions
@using Cddo.Data.Marketplace.UI.Controllers
@model QuestionIssuedRequest
@{
    ViewData["Title"] = "Date Issued";
    var errorMessage = ViewData.ModelState[nameof(Model.metadataIssuedDate)]?.Errors?.FirstOrDefault()?.ErrorMessage;
    bool isCheckList = Convert.ToBoolean(ViewBag.isCheckList ?? false);
    bool isCheckAnswers = Convert.ToBoolean(ViewBag.isCheckAnswers ?? false);
    bool isEditMode = string.Equals(ViewBag.isEditMode?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    string saveButtonName;

    if (isCheckList)
    {
        saveButtonName = "isCheckList";
    }
    else if (isCheckAnswers)
    {
        saveButtonName = "isCheckAnswers";
    }
    else
    {
        saveButtonName = "isCheckList";
    }

}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form class="form" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddPublishedDateSubmit)" asp-route-isEditMode="@isEditMode.ToString().ToLower()">
                <input type="hidden" name="@nameof(QuestionIssuedRequest.Identifier)" value="@Model?.Identifier" />
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_ErrorSummaryPartial", ViewData.ModelState)

                <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.metadataIssuedDate)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" role="group" aria-describedby="passport-issued-hint">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">
                                When was the data set first made available?
                            </h1>
                        </legend>
                        <div id="passport-issued-hint" class="govuk-hint">
                            Provide the date when you first issued the data set or published it in your data catalogue. For example, 17 03 2024.
                        </div>
                        @if (ViewData.ModelState[nameof(Model.metadataIssuedDate)]?.Errors.Any() == true)
                        {
                            <p id="metadataTitle-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span> @errorMessage
                            </p>
                        }
                        <div class="govuk-date-input" id="passport-issued">
                            <div class="govuk-date-input__item">
                                <div class="govuk-form-group">
                                    <label class="govuk-label govuk-date-input__label" for="metadataIssuedDay">
                                        Day
                                    </label>
                                    <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(ViewData.ModelState[nameof(Model.metadataIssuedDay)]?.Errors.Any() == true ? "govuk-input--error" : "")"
                                           id="metadataIssuedDay" name="@nameof(QuestionIssuedRequest.metadataIssuedDay)" type="number" inputmode="numeric" value="@(Model?.metadataIssuedDay != 0 ? Model?.metadataIssuedDay.ToString() : "")">
                                </div>
                            </div>
                            <div class="govuk-date-input__item">
                                <div class="govuk-form-group">
                                    <label class="govuk-label govuk-date-input__label" for="metadataIssuedMonth">
                                        Month
                                    </label>
                                    <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(ViewData.ModelState[nameof(Model.metadataIssuedMonth)]?.Errors.Any() == true ? "govuk-input--error" : "")"
                                           id="metadataIssuedMonth" name="@nameof(QuestionIssuedRequest.metadataIssuedMonth)" type="number" inputmode="numeric" value="@(Model?.metadataIssuedMonth != 0 ? Model?.metadataIssuedMonth.ToString() : "")">
                                </div>
                            </div>
                            <div class="govuk-date-input__item">
                                <div class="govuk-form-group">
                                    <label class="govuk-label govuk-date-input__label" for="metadataIssuedYear">
                                        Year
                                    </label>
                                    <input class="govuk-input govuk-date-input__input govuk-input--width-4 @(ViewData.ModelState[nameof(Model.metadataIssuedYear)]?.Errors.Any() == true ? "govuk-input--error" : "")"
                                           id="metadataIssuedYear" name="@nameof(QuestionIssuedRequest.metadataIssuedYear)" type="number" inputmode="numeric" value="@(Model?.metadataIssuedYear != 0 ? Model?.metadataIssuedYear.ToString() : "")">
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="govuk-button-group">
                    @if (!isEditMode)
                    {
                        <button type="submit" name="showNextQuestion" value="true" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    }
                    <button type="submit" name="@saveButtonName" value="true" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        Save and return
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>