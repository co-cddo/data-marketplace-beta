@using Cddo.Data.Marketplace.Api.Dto.Requests.Catalog.Questions
@using Cddo.Data.Marketplace.UI.Controllers
@using Cddo.Data.Marketplace.UI.Model.Enum
@using GovUk.Frontend.AspNetCore.TagHelpers
@inject Agm.Catalog.DotNet.Core.Utilities.IEnumMemberConverter EnumMemberConverter

@model QuestionUpdateFrequencyRequest
@{
    ViewData["Title"] = "Update Frequency";
    // Get the list of enum names
    var enumNames = Enum.GetNames(typeof(UpdateFrequency));

    // Check if the current UpdateFrequency is in the enum list
    var isOtherSelected = !enumNames.Contains(Model.UpdateFrequency);
    bool isCheckList = Convert.ToBoolean(ViewBag.isCheckList ?? false);
    bool isCheckAnswers = Convert.ToBoolean(ViewBag.isCheckAnswers ?? false);
    bool isEditMode = string.Equals(ViewBag.isEditMode?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    string saveButtonName;
    if (isCheckList)
    {
        saveButtonName = "isCheckList";
    }
    else if (isCheckAnswers)
    {
        saveButtonName = "isCheckAnswers";
    }
    else
    {
        saveButtonName = "isCheckList";
    }
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>
<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddFrequencySubmit)" asp-route-isEditMode="@isEditMode.ToString().ToLower()">
                <input type="hidden" name="@nameof(QuestionUpdateFrequencyRequest.Identifier)" value="@Model.Identifier" />
                <div class="govuk-form-group">
                    <fieldset class="govuk-fieldset" aria-describedby="metadataFrequency-hint">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <div class="govuk-caption-l">
                                @Model.Title
                            </div>
                            <h1 class="govuk-fieldset__heading">
                                How often is the data updated?
                            </h1>
                        </legend>
                        <div class="govuk-radios" data-module="govuk-radios">
                            @foreach (var frequency in Enum.GetValues(typeof(UpdateFrequency)).Cast<UpdateFrequency>())
                            {
                                var frequencyValue = EnumMemberConverter.GetEnumMemberValue(frequency);
                                var frequencyDescription = EnumMemberConverter.GetEnumDescription(frequency);
                                var isChecked = Model.UpdateFrequency == frequencyValue;
                                var isOther = frequency == UpdateFrequency.Other;

                                // Insert divider before "I don’t know"
                                if (frequency == UpdateFrequency.DontKnow)
                                {
                                    <div class="govuk-radios__divider">or</div>
                                }

                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" id="@frequency" name="UpdateFrequency" type="radio" value="@frequencyValue" @(isChecked ? "checked" : "") data-aria-controls="conditional-Other">
                                    <label class="govuk-label govuk-radios__label" for="@frequency">
                                        @frequencyDescription
                                    </label>
                                </div>

                                @* Check if the current option is "Other" to add conditional input *@
                                @if (frequency == UpdateFrequency.Other)
                                {
                                    <div class="govuk-radios__conditional @(isOtherSelected ? "" : "govuk-radios__conditional--hidden")" id="conditional-Other">
                                        <div class="govuk-form-group">
                                            <label class="govuk-label" for="otherUpdateFrequency">
                                                Enter a custom time period, for example ‘hourly’ or ‘every 3 years’.
                                            </label>
                                            <input class="govuk-input" id="otherUpdateFrequency" name="otherFrequency" type="text"
                                                   value="@(isOtherSelected ? Model.UpdateFrequency : "")" spellcheck="false" />
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </fieldset>
                </div>
                <div class="govuk-button-group">
                    @if (!isEditMode)
                    {
                        <button type="submit" name="showNextQuestion" value="true" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    }
                    <button type="submit" name="@saveButtonName" value="true" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        Save and return
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
