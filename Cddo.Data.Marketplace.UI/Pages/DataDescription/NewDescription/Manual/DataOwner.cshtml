@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Profiles.DcatUk.V3_1
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Profiles.DcatUk.V3_1.Enums
@using Cddo.Data.Marketplace.UI.Controllers
@using GovUk.Frontend.AspNetCore.TagHelpers
@model Cddo.Data.Marketplace.Api.Dto.Requests.Catalog.Questions.QuestionContactPointRequest
@{
    ViewData["Title"] = "Data Owner";
    var errorMessage = ViewData.ModelState[nameof(Contact.Email)]?.Errors?.FirstOrDefault()?.ErrorMessage;
    var errorMessageName = ViewData.ModelState[nameof(Contact.Name)]?.Errors?.FirstOrDefault()?.ErrorMessage;

    bool isCheckList = Convert.ToBoolean(ViewBag.isCheckList ?? false);
    bool isCheckAnswers = Convert.ToBoolean(ViewBag.isCheckAnswers ?? false);
    bool isEditMode = string.Equals(ViewBag.isEditMode?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    string saveButtonName;

    if (isCheckList)
    {
        saveButtonName = "isCheckList";
    }
    else if (isCheckAnswers)
    {
        saveButtonName = "isCheckAnswers";
    }
    else
    {
        saveButtonName = "isCheckList";
    }

    var dataOwner = Model.ContactPoint?.Where(c => c.Role == ContactRoleEnum.Owner);
}
<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-caption-l">
                @Model.Title
            </div>
            <h1 class="govuk-heading-l">
                Data owner
            </h1>
            <div id="contact-hint" class="govuk-hint">
                <p class="govuk-body">
                    The data you're listing must have an owner that can make decisions. This must be an individual.
                </p>
                <p class="govuk-body">These details will not be visible to users outside your organisation.</p>
            </div>

            <form asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddDataOwnerSubmit)" asp-route-isEditMode="@isEditMode.ToString().ToLower()">
                <input type="hidden" name="identifier" value="@Model.Identifier" />
                @await Html.PartialAsync("_ErrorSummaryPartial", ViewData.ModelState)
                <input hidden name="@nameof(Contact.Role)" value="@nameof(ContactRoleEnum.Owner)" />
                <div class="govuk-form-group @(ViewData.ModelState[nameof(Contact.Name)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                    <label class="govuk-label fw-bold" for="ContactName">
                        Name
                    </label>
                    @if (ViewData.ModelState[nameof(Contact.Name)]?.Errors.Any() == true)
                    {
                        <p id="metadataTitle-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span> @errorMessageName
                        </p>
                    }
                    <input class="govuk-input @(ViewData.ModelState[nameof(Contact.Name)]?.Errors.Any() == true ? "govuk-input--error" : "")" id="ContactName" name="@nameof(Contact.Name)" type="text" autocomplete="name" value="@dataOwner?.FirstOrDefault()?.Name">
                </div>
                <div class="govuk-form-group @(ViewData.ModelState[nameof(Contact.Email)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                    <label class="govuk-label fw-bold" for="ContactEmail">
                        Email address
                    </label>
                    @if (ViewData.ModelState[nameof(Contact.Email)]?.Errors.Any() == true)
                    {
                        <p id="metadataTitle-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span> @errorMessage
                        </p>
                    }
                    <input class="govuk-input @(ViewData.ModelState[nameof(Contact.Email)]?.Errors.Any() == true ? "govuk-input--error" : "")" id="ContactEmail" name="@nameof(Contact.Email)" type="email" autocomplete="email" value="@dataOwner?.FirstOrDefault()?.Email">
                </div>

                <div class="govuk-button-group">
                    @if (!isEditMode)
                    {
                        <button type="submit" name="showNextQuestion" value="true" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    }
                    <button type="submit" name="@saveButtonName" value="true" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        Save and return
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
