@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Profiles.DcatUk.V3_1
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Profiles.DcatUk.V3_1.Enums
@using Cddo.Data.Marketplace.UI.Controllers
@using GovUk.Frontend.AspNetCore.TagHelpers
@model Cddo.Data.Marketplace.Api.Dto.Requests.Catalog.Questions.QuestionContactPointRequest
@{
    ViewData["Title"] = "Data Owner";
    bool isCheckList = Convert.ToBoolean(ViewBag.isCheckList ?? false);
    bool isCheckAnswers = Convert.ToBoolean(ViewBag.isCheckAnswers ?? false);
    bool isEditMode = string.Equals(ViewBag.isEditMode?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    string saveButtonName;

    if (isCheckList)
    {
        saveButtonName = "isCheckList";
    }
    else if (isCheckAnswers)
    {
        saveButtonName = "isCheckAnswers";
    }
    else
    {
        saveButtonName = "isCheckList";
    }

    var dataOwner = Model.ContactPoint?.Where(c => c.Role == ContactRoleEnum.Owner);

    var contactPoint = Model.ContactPoint?.Where(c => c.Role == ContactRoleEnum.Contact);
}
<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddDataOwnerSubmit)" asp-route-isEditMode="@isEditMode.ToString().ToLower()">
                <input type="hidden" name="identifier" value="@Model.Identifier" />
                <div class="govuk-form-group">
                    <fieldset class="govuk-fieldset" aria-describedby="contact-hint">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <div class="govuk-caption-l">
                                @Model.Title
                            </div>
                            <h1 class="govuk-fieldset__heading">
                                Who is the owner of the data set?
                            </h1>
                        </legend>
                        <div id="contact-hint" class="govuk-hint">
                            The data set must have a responsible owner that can make decisions about the data, even if they’re not the point of contact.
                            Find out more about <a target="_blank" href="https://www.gov.uk/government/publications/essential-shared-data-assets-and-data-ownership-in-government/data-ownership-in-government-html" class="govuk-link">data ownership in government (opens in new tab)</a>.
                        </div>
                        <div class="govuk-radios" data-module="govuk-radios">
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="contact" name="@nameof(Contact.Role)" type="radio" value="@nameof(ContactRoleEnum.Contact)" @(!dataOwner.Any() && contactPoint.Any() ? "checked" : "")>
                                <label class="govuk-label govuk-radios__label" for="contact">
                                    The owner is the point of contact
                                </label>
                            </div>
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="contact-2" name="@nameof(Contact.Role)" type="radio" value="@nameof(ContactRoleEnum.Owner)" data-aria-controls="conditional-contact" @(dataOwner.Any() ? "checked" : "")>
                                <label class="govuk-label govuk-radios__label" for="contact-2">
                                    The owner is not the point of contact
                                </label>
                            </div>
                            <div class="govuk-radios__conditional govuk-radios__conditional--hidden" id="conditional-contact">
                                <h2 class="govuk-heading-m">
                                    Provide the name and email of the data owner
                                </h2>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="ContactName">
                                        Name
                                    </label>
                                    <input class="govuk-input" id="ContactName" name="@nameof(Contact.Name)" type="text" autocomplete="name" value="@dataOwner?.FirstOrDefault()?.Name">
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="ContactEmail">
                                        Email address
                                    </label>
                                    <input class="govuk-input" id="ContactEmail" name="@nameof(Contact.Email)" type="email" autocomplete="email" value="@dataOwner?.FirstOrDefault()?.Email">
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="govuk-button-group">
                    @if (!isEditMode)
                    {
                        <button type="submit" name="showNextQuestion" value="true" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    }
                    <button type="submit" name="@saveButtonName" value="true" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        Save and return
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
