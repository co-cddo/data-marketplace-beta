@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Cddo.Data.Marketplace.Api.Dto.Requests.Catalog.Questions
@using Cddo.Data.Marketplace.UI.Controllers
@using Newtonsoft.Json

@model QuestionDistributionRequest

@{
    ViewData["Title"] = "Supply Format";
    ViewData["identifier"] = Model?.Identifier;
    var selectedMediaType = Model?.Distribution?.FirstOrDefault()?.MediaType;
    bool isCheckList = Convert.ToBoolean(ViewBag.isCheckList ?? false);
    bool isCheckAnswers = Convert.ToBoolean(ViewBag.isCheckAnswers ?? false);
    bool isEditMode = string.Equals(ViewBag.isEditMode?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    string saveButtonName;

    if (isCheckList)
    {
        saveButtonName = "isCheckList";
    }
    else if (isCheckAnswers)
    {
        saveButtonName = "isCheckAnswers";
    }
    else
    {
        saveButtonName = "isCheckList";
    }
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddSupplyFormatSubmit)" asp-route-isEditMode="@isEditMode.ToString().ToLower()">
                <input type="hidden" name="@nameof(QuestionDistributionRequest.Identifier)" value="@Model?.Identifier" />
                <input type="hidden" name="@nameof(QuestionDistributionRequest.Distribution)" value="@JsonConvert.SerializeObject(Model?.Distribution)" />

                <div class="govuk-form-group">
                    <fieldset class="govuk-fieldset" aria-describedby="mediaType-hint">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">
                                How can users access the data?
                            </h1>
                        </legend>
                        <div id="mediaType-hint" class="govuk-hint">
                            You’ll be able to add more access methods if needed.
                        </div>
                        <div class="govuk-radios" data-module="govuk-radios">
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" id="filedownload" name="MediaType" type="radio" value="File download" >
                                <label class="govuk-label govuk-radios__label" for="filedownload">
                                        File download
                                    </label>
                                </div>
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="api" name="MediaType" type="radio" value="API">
                                <label class="govuk-label govuk-radios__label" for="api">
                                    API
                                </label>
                            </div>
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="webPage" name="MediaType" type="radio" value="Webpage">
                                <label class="govuk-label govuk-radios__label" for="webPage">
                                    Webpage
                                </label>
                            </div>
                        </div>
                        @* <div class="govuk-radios" data-module="govuk-radios">
                            @foreach (var mediaType in Enum.GetValues(typeof(MediaType)).Cast<MediaType>())
                            {
                                <div class="govuk-radios__item">
                                    @if (selectedMediaType?.FirstOrDefault() == mediaType.ToString())
                                    {
                                        <input class="govuk-radios__input" id="@mediaType" name="Distribution[0].MediaType" type="radio" value="@mediaType" checked>
                                    }
                                    else
                                    {
                                        <input class="govuk-radios__input" id="@mediaType" name="Distribution[0].MediaType" type="radio" value="@mediaType">
                                    }
                                    <label class="govuk-label govuk-radios__label" for="@mediaType">
                                        @mediaType
                                    </label>
                                </div>
                            }
                        </div> *@
                    </fieldset>
                </div>
                <div class="govuk-button-group">
                    @if (!isEditMode)
                    {
                        <button type="submit" name="showNextQuestion" value="true" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    }
                    <button type="submit" name="@saveButtonName" value="true" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        Save and return
                    </button>
                </div>
            </form>
            @if(Model.Distribution.Count() > 0)
            {
                @await Html.PartialAsync("_AccessLinksPartial", Model.Distribution, ViewData)

            }
        </div>
    </div>
</div>
