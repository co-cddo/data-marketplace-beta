@using Agm.Catalog.DotNet.Dto.Models.DataAssets
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Profiles.DcatUk.V3_1
@using Cddo.Data.Marketplace.UI.Configuration
@using Cddo.Data.Marketplace.UI.Controllers
@using GovUk.Frontend.AspNetCore.TagHelpers

@model CheckAnswersModel
@{
    ViewData["Title"] = "Check Answers";

    var cddoDataAsset = Model.CddoDataAsset;
    var propertyValidationErrors = Model.PropertyValidationErrors;

    var blockingErrorsExist = propertyValidationErrors
        .Any(propertyError => propertyError.Errors
            .Any(error => error.ErrorSeverity == DataAssetValidationPropertyErrorSeverity.Blocking));

    var warningErrorsExist = propertyValidationErrors
        .Any(propertyError => propertyError.Errors
            .Any(error => error.ErrorSeverity == DataAssetValidationPropertyErrorSeverity.Warning));

    var hasErrors = blockingErrorsExist || warningErrorsExist;

    var canPublish = cddoDataAsset?.DataAssetStatus != DataAssetStatus.Published && !hasErrors;

    var canUnPublish = cddoDataAsset?.DataAssetStatus == DataAssetStatus.Published;

    var potentialDuplicatesToDataAsset = Model.PotentialDuplicatesToDataAsset;
}

@functions
{
    private static string FormatPropertyError(IDataAssetValidationPropertyError propertyError)
    {
        return $"{propertyError.Error}";
    }

    private static string PrettifyValidationPropertyName(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return input;
        }

        var propertyNameMappings = new Dictionary<string, string>
        {
            { "ContactPoint.ContactName", "Point of contact name" },
            { "ContactPoint.Email", "Point of contact email" }
        };

        if (propertyNameMappings.TryGetValue(input, out string mappedName))
        {
            return mappedName;
        }

        // Precompile the regular expression with a timeout
        var regex = new System.Text.RegularExpressions.Regex(
            "([a-z](?=[A-Z])|[A-Z](?=[A-Z][a-z]))",
            System.Text.RegularExpressions.RegexOptions.None,
            TimeSpan.FromMilliseconds(500) // Specify a reasonable timeout
        );

        var result = regex.Replace(input, "$1 ");

        result = result.Replace(".", " ").Trim().ToLower();

        return char.ToUpper(result[0]) + result[1..];
    }

    private IEnumerable<string> GetErrorMessages(string propertyName)
    {
        var propertyError = Model.PropertyValidationErrors
            .FirstOrDefault(x => x.PropertyName.Equals(propertyName, StringComparison.InvariantCultureIgnoreCase));

        return propertyError != null
            ? propertyError.Errors.Select(FormatPropertyError)
            : Array.Empty<string>();
    }

    private static string PrettifyDuplicateSimilarityDescriptions(
        IEnumerable<string> similarityDescriptions)
    {
        var formattedSimilarityDescriptions = similarityDescriptions.Select(x => x.ToLower()).ToList();

        var numberOfFormattedSimilarityDescriptions = formattedSimilarityDescriptions.Count;

        switch (numberOfFormattedSimilarityDescriptions)
        {
            case 0: return string.Empty;

            case 1: return formattedSimilarityDescriptions.First();

            default:
                {
                    var finalFormattedSimilarityDescription = formattedSimilarityDescriptions.Last();

                    var otherFormattedSimilarityDescriptions = formattedSimilarityDescriptions.Take(formattedSimilarityDescriptions.Count - 1).ToList();

                    return $"{string.Join(", ", otherFormattedSimilarityDescriptions)} and {finalFormattedSimilarityDescription}";
                }
        }
    }
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

@if (cddoDataAsset is not null)
{
    <div class="govuk-main-wrapper">

        @if (cddoDataAsset.DataAssetStatus == DataAssetStatus.Published)
        {
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-panel govuk-panel--confirmation">
                        <h1 class="govuk-panel__title">
                            Listing published
                        </h1>
                        <div class="govuk-panel__body">
                            @cddoDataAsset.Title
                        </div>
                    </div>
                    <p class="govuk-body"><a class="govuk-link" asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAsset)" asp-route-dataAssetId="@cddoDataAsset.Id">View listing on the Data Marketplace</a></p>
                    <p class="govuk-body"><a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.TaskList)" asp-route-identifier="@cddoDataAsset.Id">Change your listing</a></p>
                    <p class="govuk-body"><a class="govuk-link" asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssetsByUser)">View all your listings</a></p>
                </div>
            </div>
        }
        else
        {
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h2 class="govuk-heading-xl">Check your answers</h2>

                    @Html.AntiForgeryToken()
                    @if (propertyValidationErrors.Any())
                    {
                        <div class="govuk-error-summary validation-summary-errors" data-module="govuk-error-summary">
                            <div role="alert">
                                <h2 class="govuk-error-summary__title">
                                    There is a problem
                                </h2>
                                <div class="govuk-error-summary__body">
                                    <ul class="govuk-list govuk-error-summary__list">
                                        @foreach (var propertyValidationError in propertyValidationErrors)
                                        {
                                            foreach (var error in propertyValidationError.Errors)
                                            {
                                                <li>
                                                    <a href="#@propertyValidationError.PropertyName">@PrettifyValidationPropertyName(propertyValidationError.PropertyName): @FormatPropertyError(error)</a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }

                    @* Potential Duplicates Section *@
                    @if (potentialDuplicatesToDataAsset.Any())
                    {
                        <div class="govuk-grid-row">
                            <section class="govuk-notification-banner" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
                                <div class="govuk-notification-banner__header">
                                    <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                                        <div class="govuk-warning-text govuk-!-static-margin-bottom-1">
                                            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                                            <strong class="govuk-warning-text__text">
                                                <span class="govuk-warning-text__assistive">Warning</span>
                                                This record might be a duplicate.
                                            </strong>
                                        </div>
                                    </h2>
                                </div>
                                <div class="govuk-notification-banner__content">
                                    <p class="govuk-body">
                                        The details you’ve provided seem to match with the following data description(s) in the Data Marketplace’s catalogue:
                                    </p>

                                    <ul class="govuk-list govuk-list--bullet">
                                        @foreach (var potentialDuplicateToDataAsset in potentialDuplicatesToDataAsset)
                                        {
                                            <li>
                                                <a class="govuk-link" asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssetByUser)" asp-route-identifier="@potentialDuplicateToDataAsset.DataAssetId">
                                                    @potentialDuplicateToDataAsset.Title
                                                </a>
                                                (based on your @PrettifyDuplicateSimilarityDescriptions(potentialDuplicateToDataAsset.SimilarityDescriptions))
                                            </li>
                                        }
                                    </ul>

                                    <p class="govuk-body">
                                        You can choose to either update that data description by following the link above, or continue with creating a new data description.
                                    </p>
                                </div>
                            </section>
                        </div>
                    }

                    <dl class="govuk-summary-list govuk-!-margin-bottom-9">
                        @* Title *@
                        <div id="@nameof(CataloguedResource.Title)" class="govuk-summary-list__row @(GetErrorMessages(nameof(CataloguedResource.Title)).Any() ? "govuk-form-group--error" : "")">
                            <dt class="govuk-summary-list__key">
                                Title
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(CataloguedResource.Title)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                @cddoDataAsset.Title
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddTitle)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden"> title</span>
                                </a>
                            </dd>
                        </div>

                        @* Description *@
                        <div id="@nameof(CataloguedResource.Description)" class="govuk-summary-list__row @(GetErrorMessages(nameof(CataloguedResource.Description)).Any() ? "govuk-form-group--error" : "")" id="@nameof(CataloguedResource.Description)">
                            <dt class="govuk-summary-list__key">
                                Description
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(CataloguedResource.Description)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                @cddoDataAsset.Description
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddDescription)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden"> description</span>
                                </a>
                            </dd>
                        </div>

                        @* Internal Identifier *@
                        <div id="@nameof(CataloguedResource.Identifier)" class="govuk-summary-list__row @(GetErrorMessages(nameof(CataloguedResource.Identifier)).Any() ? "govuk-form-group--error" : "")">
                            <dt class="govuk-summary-list__key">
                                Internal identifier
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(CataloguedResource.Identifier)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                @cddoDataAsset.InternalIdentifier
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddInternalIdentifier)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden">Internal Identifier</span>
                                </a>
                            </dd>
                        </div>

                        @* Themes *@
                        <div id="@nameof(CataloguedResource.Theme)" class="govuk-summary-list__row @(GetErrorMessages(nameof(CataloguedResource.Theme)).Any() ? "govuk-form-group--error" : "")">
                            <dt class="govuk-summary-list__key">
                                Themes
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(CataloguedResource.Theme)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                <ul class="govuk-list">
                                    @if (cddoDataAsset.Themes.Any())
                                    {
                                        @foreach (var theme in cddoDataAsset.Themes)
                                        {
                                            <li>@theme</li>
                                        }
                                    }
                                </ul>
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddThemes)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden">Themes</span>
                                </a>
                            </dd>
                        </div>

                        @* Keywords *@
                        <div id="@nameof(CataloguedResource.Keyword)" class="govuk-summary-list__row @(GetErrorMessages(nameof(CataloguedResource.Keyword)).Any() ? "govuk-form-group--error" : "")">
                            <dt class="govuk-summary-list__key">
                                Keywords
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(CataloguedResource.Keyword)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                <ul class="govuk-list">
                                    @if (cddoDataAsset.Keywords.Any())
                                    {
                                        @foreach (var keyword in @cddoDataAsset.Keywords)
                                        {
                                            <li>@keyword</li>
                                        }
                                    }
                                </ul>
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddKeywords)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden">Keywords</span>
                                </a>
                            </dd>
                        </div>

                        @* Point of Contact *@
                        <div id="ContactPoint.Contact" class="govuk-summary-list__row @(GetErrorMessages($"{nameof(CataloguedResource.ContactPoint)}.Contact").Any()  ? "govuk-form-group--error" : "")">
                            <dt class="govuk-summary-list__key">
                                Point of contact
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages($"{nameof(CataloguedResource.ContactPoint)}.Contact"))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }

                                @if (cddoDataAsset.DataAssetContacts is not null)
                                {
                                    var contactPoint = cddoDataAsset.DataAssetContacts.FirstOrDefault(x => x.Role == DataAssetContactRoleType.Contact);

                                    if (contactPoint is not null)
                                    {
                                        <span id="@($"{nameof(CataloguedResource.ContactPoint)}.{nameof(Contact.Name)}")">
                                            @contactPoint.Name
                                        </span>
                                        <br />
                                        <span id="@($"{nameof(CataloguedResource.ContactPoint)}.{nameof(Contact.Email)}")">
                                            @contactPoint.Email
                                        </span>
                                    }
                                }
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddContactPoint)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true" asp-route-dataAssetType="@cddoDataAsset.DataAssetType">
                                    Change
                                    <span class="govuk-visually-hidden">Point of Contact</span>
                                </a>
                            </dd>
                        </div>

                        @* Data Owner *@
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Data owner
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (cddoDataAsset.DataAssetContacts is not null)
                                {
                                    var ownerContact = cddoDataAsset.DataAssetContacts.FirstOrDefault(x => x.Role == DataAssetContactRoleType.Owner);

                                    if (ownerContact is not null)
                                    {
                                        <span id="@($"{nameof(CataloguedResource.ContactPoint)}.{nameof(Contact.Name)}")">
                                            @ownerContact.Name
                                        </span>
                                        <br />
                                        <span id="@($"{nameof(CataloguedResource.ContactPoint)}.{nameof(Contact.Email)}")">
                                            @ownerContact.Email
                                        </span>
                                    }
                                    else
                                    {
                                        <span>The owner is the point of contact</span>
                                    }
                                }
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddDataOwner)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden">Point of Contact</span>
                                </a>
                            </dd>
                        </div>

                        @* Date first made available *@
                        <div id="@nameof(DataSet.Issued)" class="govuk-summary-list__row @(GetErrorMessages(nameof(DataSet.Issued)).Any() ? "govuk-form-group--error" : "")">
                            <dt class="govuk-summary-list__key">
                                Date first made available
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(DataSet.Issued)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                @cddoDataAsset.Issued?.ToString("dd/MM/yyyy")
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddPublishedDate)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden">Date Issued</span>
                                </a>
                            </dd>
                        </div>

                        @* Frequency of update *@
                        <div id="@nameof(DataSet.UpdateFrequency)" class="govuk-summary-list__row @(GetErrorMessages(nameof(DataSet.UpdateFrequency)).Any() ? "govuk-form-group--error" : "")">
                            <dt class="govuk-summary-list__key">
                                Frequency of update
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(DataSet.UpdateFrequency)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                <ul class="govuk-list">
                                    @if (cddoDataAsset.UpdateFrequencyString != null)
                                    {
                                        @cddoDataAsset.UpdateFrequencyString
                                    }
                                </ul>
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddFrequency)" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden">Update frequency</span>
                                </a>
                            </dd>
                        </div>

                        @* Supply Format *@
                        <div id="@($"{nameof(DataSet.Distribution)}")" class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Supply format
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var errorMessage in GetErrorMessages(nameof(DataSet.Distribution)))
                                {
                                    <p class="govuk-error-message">@errorMessage</p>
                                }
                                <ul class="govuk-list">
                                    @if (!string.IsNullOrEmpty(cddoDataAsset.DataAssetDistribution?.MediaType))
                                    {
                                        @cddoDataAsset.DataAssetDistribution.MediaType
                                    }
                                </ul>
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" asp-controller="CatalogDataDescription" asp-route-identifier="@cddoDataAsset.Id"
                                   asp-action="@(nameof(CatalogDataDescriptionController.AddSupplyFormat))" asp-route-isCheckAnswers="true">
                                    Change
                                    <span class="govuk-visually-hidden">Data set - Delivery mechanism</span>
                                </a>
                            </dd>
                        </div>

                        @* Date Modified *@
                        <div id="@nameof(CataloguedResource.Modified)" class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Last modified
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @cddoDataAsset.Modified.ToGDSHelperString()
                            </dd>
                            <dd class="govuk-summary-list__actions">
                            </dd>
                        </div>
                    </dl>

                    <div class="govuk-button-group">
                        @if (canPublish)
                        {
                            <form asp-controller="DataDescription" asp-action="@nameof(DataDescriptionController.DataShareRequestNotificationsSelection)"
                                  asp-route-identifier="@cddoDataAsset.Id">
                                <button class="govuk-button" data-module="govuk-button">
                                    Publish data description
                                </button>
                            </form>
                        }
                        else if (canUnPublish)
                        {
                            <form asp-controller="DataDescription" asp-action="@nameof(DataDescriptionController.UpdateDataAssetStatusSubmit)"
                                  asp-route-identifier="@cddoDataAsset.Id" asp-route-dataAssetStatus="@DataAssetStatus.Draft" asp-route-dataAssetType="@cddoDataAsset.DataAssetType">
                                <button class="govuk-button" data-module="govuk-button">
                                    Unpublish data description
                                </button>
                            </form>
                            <a class="govuk-button govuk-button--secondary" asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAsset)" asp-route-dataAssetId="@cddoDataAsset.Id">View the published data description</a>
                        }

                        <a class="govuk-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.TaskList)" asp-route-identifier="@cddoDataAsset.Id">
                            View the list of questions
                        </a>
                        <a class="govuk-link" class="govuk-link" asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssetsByUser)">
                            View your department’s published records
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
<style scoped>
    .govuk-button-group {
        align-items: initial;
    }
</style>