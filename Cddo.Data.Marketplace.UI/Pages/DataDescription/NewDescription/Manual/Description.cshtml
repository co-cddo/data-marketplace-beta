@using Cddo.Data.Marketplace.Api.Dto.Requests.Catalog.Questions
@using Cddo.Data.Marketplace.UI.Controllers
@model QuestionDescriptionRequest
@{
    ViewData["Title"] = "Description";
    bool isCheckList = Convert.ToBoolean(ViewBag.isCheckList ?? false);
    bool isCheckAnswers = Convert.ToBoolean(ViewBag.isCheckAnswers ?? false);
    bool isEditMode = string.Equals(ViewBag.isEditMode?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    string saveButtonName;

    if (isCheckList)
    {
        saveButtonName = "isCheckList";
    }
    else if (isCheckAnswers)
    {
        saveButtonName = "isCheckAnswers";
    }
    else
    {
        saveButtonName = "isCheckList";
    }
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddDescriptionSubmit)" asp-route-isEditMode="@isEditMode.ToString().ToLower()">
                <input type="hidden" name="@nameof(QuestionDescriptionRequest.Identifier)" value="@Model.Identifier" />
                <div class="govuk-form-group">
                    <div class="govuk-caption-l">
                        @Model.Title
                    </div>
                    <h1 class="govuk-label-wrapper">
                        <label class="govuk-label govuk-label--l" for="metadataDescription">
                            Provide a description of the data set
                        </label>
                    </h1>
                    <div id="metadataDescription-hint" class="govuk-hint">
                        Explain what the data is about and what’s in it. Start with a clear summary because only the first 160 characters will appear when this description is listed in search results.
                    </div>
                    <textarea class="govuk-textarea" id="metadataDescription" name="@nameof(QuestionDescriptionRequest.Description)" rows="5" aria-describedby="metadataDescription-hint">@Model.Description</textarea>
                </div>
                <div class="govuk-button-group">
                    @if (!isEditMode)
                    {
                        <button type="submit" name="showNextQuestion" value="true" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    }
                    <button type="submit" name="@saveButtonName" value="true" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        Save and return
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>