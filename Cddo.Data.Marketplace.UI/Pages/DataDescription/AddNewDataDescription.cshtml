@using Cddo.Data.Marketplace.UI.Controllers
@using Cddo.Data.Marketplace.UI.Model.Enum
@using GovUk.Frontend.AspNetCore.TagHelpers
@model Cddo.Data.Marketplace.UI.Pages.DataDescription.AddNewModel

@{
    ViewData["Title"] = "Add Data Description";
}

<a class="govuk-back-link" asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.DataDescriptionDashboard)">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form asp-controller="CatalogDataDescription" asp-action="@nameof(CatalogDataDescriptionController.AddDataDescriptionMethodSubmit)">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_ErrorSummaryPartial", ViewData.ModelState)

                @{
                    var hasError = ViewData.ModelState["dataDescriptionMethod"]?.Errors.Any() == true;
                }

                <div class="govuk-form-group @(hasError ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" aria-describedby="dataDescription-hint">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">
                                Choose how to add your listing
                            </h1>
                        </legend>
                        <div id="dataDescription-hint" class="govuk-hint">
                            Your listing will be published in the Data Marketplace.
                        </div>

                        @if (hasError)
                        {
                            <p id="metadataTitle-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span> Select how you want to add your data description
                            </p>
                        }

                        <div class="govuk-radios" data-module="govuk-radios">
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input"
                                       id="manual"
                                       name="method"
                                       type="radio"
                                       value="@nameof(NewDataDescriptionMethod.Manual)">
                                <label class="govuk-label govuk-radios__label" for="manual">
                                    Complete a web form
                                </label>
                            </div>
                            @* <div class="govuk-radios__item">
                                <input class="govuk-radios__input"
                                       id="spreadsheet"
                                       name="method"
                                       type="radio"
                                       value="@nameof(NewDataDescriptionMethod.Spreadsheet)">
                                <label class="govuk-label govuk-radios__label" for="spreadsheet">
                                    Upload a spreadsheet
                                </label>
                            </div> *@
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input"
                                       id="API"
                                       name="method"
                                       type="radio"
                                       value="@nameof(NewDataDescriptionMethod.API)">
                                <label class="govuk-label govuk-radios__label" for="API">
                                    Connect to the Data Marketplace API
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <button class="govuk-button" data-module="govuk-button">Continue</button>
            </form>
        </div>
        <div class="govuk-grid-column-one-third">
            <h2 class="govuk-heading-m">
                More information
            </h2>
            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.PublishingPage)">
                    Learn about listings and the details we ask for
                </a>
            </p>
        </div>
    </div>
</div>
