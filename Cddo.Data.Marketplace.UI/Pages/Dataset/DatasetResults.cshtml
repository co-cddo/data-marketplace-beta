@using Agm.Catalog.DotNet.Dto.Models.DataAssets
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Agm.Catalog.DotNet.Dto.Requests.DataAssets;
@using Agm.Catalog.DotNet.Dto.Responses.DataAssets
@using Cddo.Data.Marketplace.UI.Controllers
@using Cddo.Data.Marketplace.UI.Configuration

@model Cddo.Data.Marketplace.UI.Pages.Dataset.DatasetResultsModel
@{
    ViewData["Title"] = "Data set Results";

    var dataAssets = Model.DataAssets;
    var totalNumberOfResults = Model.TotalNumberOfResults;

    var topics = Model.Topics;
    var organisations = Model.Organisations;
    var accessRights = Model.AccessRights;

    var sortOption = Context.Request.Query["sortOption"].ToString();
    if (!string.IsNullOrEmpty(sortOption) && sortOption.Contains('|'))
    {
        var sortParts = sortOption.Split('|');
        ViewData["SortField"] = Enum.Parse(typeof(DataAssetsSortField), sortParts[0]);
        ViewData["SortDirection"] = Enum.Parse(typeof(DataAssetsSortDirection), sortParts[1]);
    }
    else
    {
        ViewData["SortField"] = DataAssetsSortField.Relevance;
        ViewData["SortDirection"] = DataAssetsSortDirection.Descending;
    }

    var totalNumberOfPages = (int)Math.Ceiling((double)totalNumberOfResults / ViewBag.NumberOfRecords);
    var currentPageNumber = Math.Max(1, Math.Min(ViewBag.PageNumber, totalNumberOfPages));

    const int maxMiddlePages = 3;
    var middleStart = Math.Max(1, currentPageNumber - maxMiddlePages / 2);
    var middleEnd = Math.Min(totalNumberOfPages, middleStart + maxMiddlePages - 1);
    middleStart = Math.Max(1, middleEnd - maxMiddlePages + 1);

    if (totalNumberOfPages <= maxMiddlePages)
    {
        middleStart = 1;
        middleEnd = totalNumberOfPages;
    }

    if (currentPageNumber < middleStart)
    {
        currentPageNumber = middleStart;
    }
    else if (currentPageNumber > middleEnd)
    {
        currentPageNumber = middleEnd;
    }
}

@section Styles
{
    <link rel="stylesheet" href="~/css/dataset-results.css" />
    <style>
        .suggestions {
            list-style-type: none;
            margin: 0;
            padding: 0;
            border: 1px solid #ccc;
            max-height: 150px;
            overflow-y: auto;
            position: absolute;
            background-color: white;
            width: calc(100% - 30px);
            left: 0;
            top: 100%;
            z-index: 1000;
            box-sizing: border-box;
        }

            .suggestions li {
                padding: 10px;
                cursor: pointer;
            }

                .suggestions li:hover {
                    background-color: #f0f0f0;
                }

        .govuk-tag--grey {
            text-transform: inherit !important;
        }
    </style>
}

@section Scripts
{
    <script asp-add-nonce="true">
        document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById('catalogDataSearchInput');
        const searchList = document.getElementById('catalogDataSearchList');

        searchInput.addEventListener('input', function (e) {
        const searchTerm = e.target.value.trim().toLowerCase();
        if (searchTerm.length === 0) {
        searchList.innerHTML = '';
        searchList.style.display = 'none';
        return;
        }

        fetch(`/catalogData/GetSearchSuggestionsForPublishedDataAssets?searchText=${encodeURIComponent(searchTerm)}`, {
        credentials: 'include'
        })
        .then(response => {
        if (response.redirected) {
        window.location.href = response.url;
        return;
        }
        if (!response.ok) {
        throw new Error('Network response was not ok');
        }
        return response.json();
        })
        .then(data => {
        console.log('Fetched data:', data); // Log the response data
        if (data.length === 0) {
        searchList.innerHTML = '';
        searchList.style.display = 'none';
        return;
        }
        const optionsHTML = data.map(item => `<li>${item}</li>`).join('');
        searchList.innerHTML = optionsHTML;
        searchList.style.display = 'block';
        })
        .catch(error => {
        console.error('Error fetching data:', error);
        searchList.innerHTML = '';
        searchList.style.display = 'none';
        });
        });

        searchList.addEventListener('click', function (e) {
        if (e.target.tagName === 'LI') {
        searchInput.value = e.target.textContent;
        searchList.innerHTML = '';
        searchList.style.display = 'none';
        }
        });

        document.addEventListener('click', function (e) {
        if (!searchInput.contains(e.target) && !searchList.contains(e.target)) {
        searchList.style.display = 'none';
        }
        });
        });
    </script>
}

@functions
{
    public static string PrettifyString(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;

        char[] delimiters = { '-', ' ' };

        var inputTokens = input.Split(separator: delimiters,
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        var prettyTokens = inputTokens.Select(token =>
        {
            // Check for specific abbreviations like "HM" (you can add more abbreviations as needed)
            if (token.Equals("HM", StringComparison.OrdinalIgnoreCase))
            {
                return "HM"; // Keep it as uppercase "HM"
            }

            // Default prettify logic for non-abbreviations
            var firstCharInUpperCase = char.ToUpper(token.First());

            var restOfToken = token.Length > 1 ? token.Substring(1) : string.Empty;

            return $"{firstCharInUpperCase}{restOfToken}";
        });

        return string.Join(" ", prettyTokens);
    }

    public static string PrettifyAccessRightsString(string? input) => input == "OPEN" ? "Open" : "On request";

    public static string RenderDescription(string? description)
    {
        if (!string.IsNullOrEmpty(description) && description.Length > 160)
        {
            return $"{description[..160]}...";
        }
        else
        {
            return description ?? string.Empty;
        }
    }

    public static string FormatAssetType(string assetType) => assetType == "DataSet" ? "Dataset" : assetType.ToUpper();
}

<div class="govuk-width-container">
    <a class="govuk-back-link" href="javascript:window.history.back()">Back</a>
    <div class="govuk-main-wrapper">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">
            Find government data
        </h1>
        <form asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssets)" method="get">
            <div class="govuk-grid-row mb-5">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-form-group mb-2 search-input">
                        <div class="govuk-input__wrapper" style="position: relative;">
                            <input aria-label="Search data description" class="govuk-input govuk-input--width-30" id="catalogDataSearchInput" name="searchText" type="text" list="catalogDataSearchList" autocomplete="off" value="@ViewBag.SearchText">

                            <script>
                                document.getElementById('catalogDataSearchInput').addEventListener('keydown', function (e) {
                                    console.log("key pressed");
                                });
                            </script>

                            <button title="datasetSearchResultsBtn" class="search-button" type="submit" enterkeyhint="search">
                                <svg class="search-button__icon" width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                                    <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
                                    <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line>
                                </svg>
                            </button>
                            <ul id="catalogDataSearchList" class="suggestions" style="display:none;"></ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-third">
                    <div class="accordion accordion-flush accordion-filter" id="accordionFlushExample">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-topics">
                                <button class="accordion-button collapsed govuk-link" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseTopics" aria-controls="flush-collapseTopics">
                                    Topic
                                </button>
                            </h2>
                            <div id="flush-collapseTopics" class="accordion-collapse collapse show" aria-labelledby="flush-topics" data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body">
                                    <div class="govuk-form-group">
                                        <fieldset class="govuk-fieldset">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m visually-hidden">
                                                <h1 class="govuk-fieldset__heading">
                                                    Topic
                                                </h1>
                                            </legend>
                                            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                                @if (topics != null && topics.Any())
                                                {
                                                    @foreach (var topic in topics.OrderBy(x => x))
                                                    {
                                                        <div class="govuk-checkboxes__item">
                                                            <input class="govuk-checkboxes__input" id="@topic" name="selectedTopics" type="checkbox" value="@topic" @(ViewBag?.Themes?.Contains(@topic) ? "checked" : "") onchange="this.form.submit()">
                                                            <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16" for="@topic">
                                                                @topic
                                                            </label>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-organisations">
                                <button class="accordion-button collapsed govuk-link" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOrganisations" aria-controls="flush-collapseOrganisations">
                                    Organisation
                                </button>
                            </h2>
                            <div id="flush-collapseOrganisations" class="accordion-collapse collapse show" aria-labelledby="flush-organisations" data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body">
                                    <div class="govuk-form-group">
                                        <fieldset class="govuk-fieldset">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m visually-hidden">
                                                <h1 class="govuk-fieldset__heading">
                                                    Organisation
                                                </h1>
                                            </legend>
                                            <div class="govuk-checkboxes govuk-checkboxes--small filter-list" data-module="govuk-checkboxes">
                                                @if (organisations.Any())
                                                {
                                                    @foreach (var organisation in organisations.OrderBy(x => x))
                                                    {
                                                        <div class="govuk-checkboxes__item">
                                                            <input class="govuk-checkboxes__input" id="@organisation" name="selectedOrganisations" type="checkbox" value="@organisation" @(ViewBag?.Creator?.Contains(@organisation) ? "checked" : "") onchange="this.form.submit()">
                                                            <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16" for="@organisation">
                                                                @PrettifyString(@organisation)
                                                            </label>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-asset">
                                <button class="accordion-button collapsed govuk-link " type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseAsset" aria-controls="flush-collapseAsset">
                                    Type
                                </button>
                            </h2>
                            <div id="flush-collapseAsset" class="accordion-collapse collapse show" aria-labelledby="flush-asset" data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body">
                                    <div class="govuk-form-group">
                                        <fieldset class="govuk-fieldset">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m visually-hidden">
                                                <h1 class="govuk-fieldset__heading">
                                                    Type
                                                </h1>
                                            </legend>
                                            <div class="govuk-checkboxes govuk-checkboxes--small filter-list" data-module="govuk-checkboxes">
                                                @if (Model.DataAssetTypes.Contains("DataSet"))
                                                {
                                                    <div class="govuk-checkboxes__item">
                                                        <input class="govuk-checkboxes__input" id="dataSet" name="selectedDataAssetTypes" type="checkbox" value="@DataAssetType.DataSet" @(ViewBag?.DataAssetTypes?.Contains(DataAssetType.DataSet) ? "checked" : "")>
                                                        <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16" for="dataSet">
                                                            Data set
                                                        </label>
                                                    </div>
                                                }
                                                @if (Model.DataAssetTypes.Contains("DataService"))
                                                {
                                                    <div class="govuk-checkboxes__item">
                                                        <input class="govuk-checkboxes__input" id="dataService" name="selectedDataAssetTypes" type="checkbox" value="@DataAssetType.DataService" @(ViewBag?.DataAssetTypes?.Contains(DataAssetType.DataService) ? "checked" : "")>
                                                        <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16" for="dataService">
                                                            Data Service
                                                        </label>
                                                    </div>
                                                }

                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-access">
                                <button class="accordion-button collapsed govuk-link " type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseAccess" aria-controls="flush-collapseAccess">
                                    Access
                                </button>
                            </h2>
                            <div id="flush-collapseAccess" class="accordion-collapse collapse show" aria-labelledby="flush-access" data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body">
                                    <div class="govuk-form-group">
                                        <fieldset class="govuk-fieldset">
                                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m visually-hidden">
                                                <h1 class="govuk-fieldset__heading">
                                                    Access
                                                </h1>
                                            </legend>
                                            <div class="govuk-checkboxes govuk-checkboxes--small filter-list" data-module="govuk-checkboxes">
                                                @if (accessRights != null && accessRights.Any())
                                                {
                                                    @foreach (var accessRight in accessRights.OrderBy(x => x))
                                                    {
                                                        <div class="govuk-checkboxes__item">
                                                            <input class="govuk-checkboxes__input" id="@accessRight" name="selectedAccessRights" type="checkbox" value="@accessRight" @(ViewBag?.AccessRights?.Contains(@accessRight) ? "checked" : "") onchange="this.form.submit()">
                                                            <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16" for="@accessRight">
                                                                @PrettifyAccessRightsString(@accessRight)
                                                            </label>
                                                        </div>
                                                    }
                                                }
                                                @*   <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="dataSet" name="selectedAccess" type="checkbox" onchange="this.form.submit()">
                                                    <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16" for="open">
                                                        Open
                                                    </label>
                                                </div>
                                                <div class="govuk-checkboxes__item">
                                                    <input class="govuk-checkboxes__input" id="onrequest" name="selectedAccess" type="checkbox" onchange="this.form.submit()">
                                                    <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16" for="onrequest">
                                                        On request
                                                    </label>
                                                </div> *@
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="govuk-button-group">
                        <noscript>
                            <button type="submit" class="govuk-button" data-module="govuk-button"
                                    asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssets)">
                                Apply filter
                            </button>
                        </noscript>
                    </div>
                </div>
                <div class="govuk-grid-column-two-thirds">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <p class="govuk-hint">@totalNumberOfResults results</p>

                        <div class="govuk-form-group d-flex gap-2 align-items-center">
                            <label class="govuk-label" for="sortOption">
                                Sort by
                            </label>
                            <select class="govuk-select" name="sortOption" id="sortOption" aria-label="Sort by" onchange="this.form.submit()">
                                <option value="@DataAssetsSortField.Title|@DataAssetsSortDirection.Ascending"
                                        selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.Title.ToString() &&
                                            Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Ascending.ToString())">
                                    Alphabetical A-Z
                                </option>
                                <option value="@DataAssetsSortField.Title|@DataAssetsSortDirection.Descending"
                                        selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.Title.ToString() &&
                                            Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Descending.ToString())">
                                    Alphabetical Z-A
                                </option>
                                <option value="@DataAssetsSortField.UpdatedOn|@DataAssetsSortDirection.Descending"
                                        selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.UpdatedOn.ToString() &&
                                            Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Descending.ToString())">
                                    Modified (newest)
                                </option>
                                <option value="@DataAssetsSortField.UpdatedOn|@DataAssetsSortDirection.Ascending"
                                        selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.UpdatedOn.ToString() &&
                                            Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Ascending.ToString())">
                                    Modified (oldest)
                                </option>
                                <option value="@DataAssetsSortField.Relevance|@DataAssetsSortDirection.Descending"
                                        selected="@(Convert.ToString(ViewData["SortField"]) == DataAssetsSortField.Relevance.ToString() &&
                                            Convert.ToString(ViewData["SortDirection"]) == DataAssetsSortDirection.Descending.ToString())">
                                    Relevance
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="">
                        <div class="govuk-!-margin-bottom-5">
                            @if (@dataAssets.Any())
                            {
                                @foreach (var dataAsset in dataAssets)
                                {
                                    <div class="govuk-!-margin-bottom-7">
                                        <p class="govuk-body govuk-!-margin-bottom-3">
                                            <a asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAsset)"
                                               asp-route-dataAssetId="@dataAsset.Id" class="govuk-!-font-weight-bold govuk-link">
                                                @dataAsset?.Title
                                            </a>
                                        </p>

                                        <p class="govuk-body govuk-!-margin-bottom-3 govuk-hint">
                                            @dataAsset?.PublisherPrettified
                                        </p>

                                        <div class="govuk-!-margin-bottom-4">
                                            @{
                                                var mediaTypes = dataAsset.DataAssetDistribution?.Select(d => d.MediaType?.ToString()).ToList() ?? new List<string>();
                                                var tags = new List<string>();

                                                if (mediaTypes.Contains("API"))
                                                {
                                                    tags.Add("API");
                                                }

                                                if (mediaTypes.Contains("File download") || mediaTypes.Contains("text/html"))
                                                {
                                                    tags.Add("Dataset");
                                                }

                                                if (dataAsset.AccessRights == "RESTRICTED")
                                                {
                                                    tags.Add("Access on request");
                                                }
                                            }

                                            @foreach (var tag in tags)
                                            {
                                                <strong class="govuk-tag govuk-tag--grey">
                                                    @tag
                                                </strong>
                                            }
                                        </div>

                                        <div class="govuk-!-margin-bottom-0 govuk-!-margin-top-1">
                                            <p class="govuk-body govuk-!-font-size-16">
                                                @RenderDescription(dataAsset?.Description)
                                            </p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="govuk-body">No results found.</p>
                            }
                        </div>
                    </div>

                    @if (@dataAssets.Any())
                    {
                        <nav class="govuk-pagination" role="navigation" aria-label="Pagination">

                            @if (currentPageNumber != 1)
                            {
                                <div class="govuk-pagination__prev">
                                    <button type="submit" class="govuk-link govuk-pagination__link"
                                            asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssets)"
                                            name="selectedPageNumber" value="@(currentPageNumber - 1)" rel="prev">
                                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                            <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                                        </svg>
                                        <span class="govuk-pagination__link-title">
                                            <strong>Previous</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
                                    </button>
                                </div>
                            }
                            <ul class="govuk-pagination__list">
                                @if (middleStart > 1)
                                {
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link"
                                                asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssets)"
                                                name="selectedPageNumber" value="1">
                                            1
                                        </button>
                                    </li>
                                    @if (middleStart > 2)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                }

                                @for (int i = middleStart; i <= middleEnd; i++)
                                {
                                    <li class="govuk-pagination__item @(i == currentPageNumber ? "govuk-pagination__item--current" : "")">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link"
                                                asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssets)"
                                                name="selectedPageNumber" value="@i">
                                            @i
                                        </button>
                                    </li>
                                }

                                @if (middleEnd < totalNumberOfPages)
                                {
                                    @if (middleEnd < totalNumberOfPages - 1)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link"
                                                asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssets)"
                                                name="selectedPageNumber" value="@totalNumberOfPages">
                                            @totalNumberOfPages
                                        </button>
                                    </li>
                                }
                            </ul>

                            @if (currentPageNumber != totalNumberOfPages)
                            {
                                <div class="govuk-pagination__next">
                                    <button type="submit" class="govuk-link govuk-pagination__link"
                                            asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.GetCddoDataAssets)"
                                            name="selectedPageNumber" value="@(currentPageNumber + 1)" rel="next">
                                        <span class="govuk-pagination__link-title">
                                            <strong>Next</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
                                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                            <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </nav>
                    }
                </div>
            </div>
        </form>
    </div>
</div>