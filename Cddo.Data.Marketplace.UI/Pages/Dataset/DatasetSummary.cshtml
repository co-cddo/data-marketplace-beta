@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Agm.Catalog.DotNet.Dto.Responses.DataAssets
@using Cddo.Data.Marketplace.UI.Configuration
@using Cddo.Data.Marketplace.UI.Services.Interfaces
@using Cddo.Data.Marketplace.UI.Controllers
@inject ICatalogDataService _catalogDataService
@model GetCddoDataAssetResponse
@{
    var dataAsset = Model.CddoDataAsset;
    var contactPoint = dataAsset.DataAssetContacts.FirstOrDefault(x => x.Role == DataAssetContactRoleType.Contact);
    var fileDownloads = dataAsset.DataAssetDistribution?.Where(d => d.MediaType?.ToString() == "File download").ToList();
    var apis = dataAsset.DataAssetDistribution?.Where(d => d.MediaType?.ToString() == "API").ToList();
    var webpages = dataAsset.DataAssetDistribution?.Where(d => d.MediaType?.ToString() == "text/html").ToList();

    ViewData["Title"] = dataAsset.Title;
}

@functions {
    public static string FormatDateTime(DateTime? dateTime) => dateTime?.ToString("d MMMM yyyy") ?? "";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/dataset-detail.min.css" />
}

<a class="govuk-back-link" asp-controller="CatalogData"
   asp-action="@nameof(CatalogDataController.GetCddoDataAssets)">Back</a>

@if (dataAsset != null)
{
    <div class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                @{
                    var labels = new HashSet<string>();

                    if ((webpages != null && webpages.Any()) || (fileDownloads != null && fileDownloads.Any()))
                    {
                        labels.Add("Dataset");
                    }

                    if (apis != null && apis.Any())
                    {
                        labels.Add("API");
                    }

                    if (dataAsset.DataAssetDistribution == null && dataAsset.DataAssetType == DataAssetType.DataService)
                    {
                        labels.Add("Data Service");
                    }
                    else if (dataAsset.DataAssetDistribution == null && !labels.Contains("Dataset"))
                    {
                        labels.Add("Dataset");
                    }
                }

                <span class="govuk-caption-xl">
                    @string.Join(", ", labels)
                </span>
                <h1 class="govuk-heading-xl">@dataAsset.Title</h1>

                @if (!string.IsNullOrEmpty(dataAsset.Description))
                {
                    <p class="govuk-body overflow-wrap" id="dataset-description">@dataAsset.Description</p>
                }

                <dl class="govuk-summary-list govuk-summary-list--no-border">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Organisation
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @dataAsset?.PublisherPrettified
                        </dd>
                    </div>

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            First published
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @FormatDateTime(dataAsset?.Issued)
                        </dd>
                    </div>

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Update frequency
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @(dataAsset?.UpdateFrequencyString == "DontKnow" ? "Not known" : dataAsset?.UpdateFrequencyString)
                        </dd>
                    </div>

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Licence
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @if (string.IsNullOrEmpty(dataAsset?.License?.Title))
                            {
                                <span>Not known</span>
                            }
                            else if (string.IsNullOrEmpty(dataAsset.License.LicenseUrl))
                            {
                                <span>@dataAsset.License.Title</span>
                            }
                            else
                            {
                                <a class="govuk-link" href="@dataAsset.License.LicenseUrl">@dataAsset.License.Title</a>
                            }
                        </dd>
                    </div>
                </dl>
                @if (dataAsset?.AccessRights == "RESTRICTED" && Model.CddoDataAsset.AllowDSRRequest == true && Model.CddoDataAsset.RequiresDSR == true)
                {
                    <h2 class="govuk-heading-m">Request this data</h2>
                    <p class="govuk-body">
                        This data contains sensitive information and requires a data share agreement with @dataAsset?.PublisherPrettified.
                    </p>
                    <p class="govuk-body">
                        <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.RequestingRestrictedData)">Learn about requesting restricted data</a>
                    </p>
                    <form class="form" method="get">
                        <button type="submit" class="govuk-button" data-module="govuk-button"
                                asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.StartDataShareRequestPrompt)"
                                asp-route-dataAssetId="@dataAsset?.Id">
                            Start a data request
                        </button>
                    </form>
                }

                @if (webpages != null && webpages.Any() && dataAsset?.AccessRights != "RESTRICTED")
                {
                    <h2 class="govuk-heading-m">Data links</h2>
                    <ul class="govuk-list" id="accessLinks">
                        @foreach (var webpage in webpages)
                        {
                            <li><a class="govuk-link" href="@webpage.DownloadUrl">@webpage.Title</a></li>
                        }
                    </ul>
                }

                @if (fileDownloads != null && fileDownloads.Any() && dataAsset?.AccessRights != "RESTRICTED")
                {
                    <h2 class="govuk-heading-m">Downloads</h2>
                    <dl class="govuk-summary-list govuk-summary-list--no-border" id="downloadLinks">
                        @foreach (var file in fileDownloads)
                        {
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key govuk-!-width-one-half">
                                    <a class="govuk-link" href="@file.DownloadUrl">@file.Title</a>
                                </dt>
                                <dd class="govuk-summary-list__value govuk-!-width-one-half">@file.Format</dd>
                            </div>
                        }
                    </dl>
                }

                @if (apis != null && apis.Any())
                {
                    <h2 class="govuk-heading-m">API documentation</h2>
                    @if (dataAsset?.AccessRights == "RESTRICTED")
                    {
                        <p class="govuk-body">This API requires approval before usage.</p>
                    }

                    <p class="govuk-body">You can access this data using an API. <a class="govuk-link" href="https://www.postman.com/what-is-an-api/">Find out more about APIs</a>.</p>
                    <ul class="govuk-list" id="accessLinks">
                        @foreach (var api in apis)
                        {
                            <li><a class="govuk-link" href="@api.AccessUrl">@api.Title</a></li>
                        }
                    </ul>
                }

                @* Contact *@
                <h2 class="govuk-heading-m">Contact</h2>
                <p class="govuk-body">
                    For questions about this data contact:
                </p>
                <p class="govuk-body">
                    <a class="govuk-link" href="mailto:@(contactPoint?.Email)">
                        @contactPoint?.Email
                    </a>
                </p>
                <p class="govuk-body govuk-!-margin-top-9 govuk-hint">
                    This page was last updated @FormatDateTime(dataAsset?.Modified).
                </p>
            </div>
        </div>
    </div>
}
<style scoped>
    .overflow-wrap {
        overflow-wrap: break-word;
    }

    .govuk-summary-list__key a {
        font-weight: 400;
    }
</style>