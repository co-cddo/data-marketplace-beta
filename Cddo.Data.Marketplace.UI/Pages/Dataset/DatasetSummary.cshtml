@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Agm.Catalog.DotNet.Dto.Responses.DataAssets
@using Cddo.Data.Marketplace.UI.Configuration
@using Cddo.Data.Marketplace.UI.Services.Interfaces
@using Cddo.Data.Marketplace.UI.Controllers
@inject ICatalogDataService _catalogDataService
@model GetCddoDataAssetResponse
@{
    ViewData["Title"] = "Data set Summary";
    var dataAsset = Model.CddoDataAsset;
    var contactPoint = Model.CddoDataAsset.DataAssetContacts.FirstOrDefault(x => x.Role == DataAssetContactRoleType.Contact);
    var contactOwner = Model.CddoDataAsset.DataAssetContacts.FirstOrDefault(x => x.Role == DataAssetContactRoleType.Owner);
}

@functions {

    public static string FormatDateTime(DateTime? dateTime)
    {
        if (dateTime == null) return "";

        var suffix = new[] { "th", "st", "nd", "rd" };
        int day = dateTime.Value.Day;
        int mod100 = day % 100;
        string formattedDate = dateTime.Value.ToString("dd MMMM yyyy HH:mm");
        string daySuffix;
        if (mod100 > 10 && mod100 < 20)
        {
            daySuffix = suffix[0];
        }
        else
        {
            int daySuffixIndex = (day % 10) < 4 ? day % 10 : 0;
            daySuffix = suffix[daySuffixIndex];
        }

        return day + daySuffix + " " + formattedDate.Substring(2);
    }
}

@section Styles
{
    <link rel="stylesheet" href="~/css/dataset-detail.min.css" />
}

<a class="govuk-back-link" asp-controller="CatalogData"
   asp-action="@nameof(CatalogDataController.StartCddoDataAssetsSearch)">Back</a>

@if (dataAsset != null)
{
    <div class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds-from-desktop govuk-!-margin-bottom-4">
                <span class="govuk-caption-xl">@dataAsset.PublisherPrettified</span>
                <h1 class="govuk-heading-xl govuk-!-margin-bottom-1">@dataAsset.Title</h1>
                <p class="govuk-caption-m"><strong>@dataAsset.Modified.ToLastUpdatedString()</strong></p>
                <p class="govuk-body govuk-!-margin-bottom-5">
                    <strong class="govuk-tag govuk-tag--blue mb-1">@dataAsset.DataAssetType</strong>
                    @if (dataAsset.ManifestationTypes.Any())
                    {
                        <span>|</span>
                        @foreach (var type in dataAsset.ManifestationTypes!)
                        {
                            <strong class="govuk-tag govuk-tag--grey mb-1">@type</strong>
                        }
                    }
                </p>
                @if (dataAsset?.Description != null)
                {
                    <p class="govuk-body overflow-wrap" id="dataset-description">
                        @dataAsset.Description
                    </p>
                }
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds-from-desktop govuk-!-margin-bottom-8">
                <div class="dataset-additional-details govuk-!-margin-bottom-8">
                    <h2 class="govuk-heading-l">Request this data set</h2>

                    <p class="govuk-body">This data contains sensitive information (such as personal details) and requires a data share agreement with @dataAsset.PublisherPrettified.</p>
                    <p class="govuk-body">To request this data, you need to <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.DataShareQuestions)">answer some questions</a>.</p>
                    <p class="govuk-body">Your answers will be reviewed by @dataAsset.PublisherPrettified.</p>

                    @if (Model.CddoDataAsset.AllowDSRRequest.HasValue && Model.CddoDataAsset.AllowDSRRequest.Value)
                    {
                        @if (Model.CddoDataAsset.RequiresDSR.HasValue && Model.CddoDataAsset.RequiresDSR.Value)
                        {
                            <form class="form" method="get">
                                <button type="submit" class="govuk-button" data-module="govuk-button"
                                        asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.StartDataShareRequestPrompt)"
                                        asp-route-dataAssetId="@dataAsset.Id">
                                    Start a data share request
                                </button>
                            </form>
                        }
                        else
                        {
                            <h3 class="govuk-heading-s">This data set can not be requested for a data share yet</h3>
                        }
                    }
                    else
                    {
                        <h3 class="govuk-heading-s">This data set does not require a data share</h3>
                    }
                </div>
                <h2 class="govuk-heading-l">Further information</h2>
                <table class="govuk-table govuk-!-margin-bottom-8">
                    <tbody class="govuk-table__body">                       
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-width-one-half">Publisher</th>
                            <td class="govuk-table__cell govuk-!-width-one-half">
                                @dataAsset.PublisherPrettified
                            </td>
                        </tr>                        
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-width-one-half">Security Classification</th>
                            <td class="govuk-table__cell govuk-!-width-one-half">@dataAsset.SecurityClassification</td>
                        </tr>                       
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-width-one-half">Updated</th>
                            <td class="govuk-table__cell govuk-!-width-one-half">@dataAsset.Modified.ToGDSHelperString()</td>
                        </tr>
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-width-one-half">Contact</th>
                            <td class="govuk-table__cell govuk-!-width-one-half">
                                @if (contactPoint is not null)
                                {
                                    if (string.IsNullOrEmpty(contactPoint.Email))
                                    {
                                        @contactPoint.Name
                                    }
                                    else
                                    {
                                        <a class="govuk-link" href="mailto:@(contactPoint.Email)">@contactPoint.Name</a>
                                    }
                                }
                            </td>
                        </tr>
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-width-one-half">Data Owner</th>
                            <td class="govuk-table__cell govuk-!-width-one-half">
                                @if (contactOwner is not null)
                                {
                                    if (string.IsNullOrEmpty(contactOwner.Email))
                                    {
                                        @contactOwner.Name
                                    }
                                    else
                                    {
                                        <a class="govuk-link" href="mailto:@(contactOwner.Email)">@contactOwner.Name</a>
                                    }
                                }
                                else
                                {
                                    <span>The owner is the point of contact</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
<style scoped>
    .overflow-wrap{
        overflow-wrap: break-word;
    }
</style>