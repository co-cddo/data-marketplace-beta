@using Agrimetrics.DataShare.Api.Dto.Models.DataShareRequests
@model Agrimetrics.DataShare.Api.Dto.Models.Supplier.DataShareRequests.Decisions.AcceptedDecisionSummary
@{
    ViewData["Title"] = "Request Accepted";
}

<div class="govuk-main-wrapper govuk-main-wrapper--l">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            
            @if (Model.RequestStatus == DataShareRequestStatus.Cancelled)
            {
                <div class="govuk-panel govuk-panel--confirmation">
                    <h1 class="govuk-panel__title">
                        Request was cancelled
                    </h1>
                </div>

                <span class="govuk-caption-l">Request ID: @Model.DataShareRequestRequestId</span>
                <br/>
            }
            else
            {
                <div class="govuk-panel govuk-panel--confirmation">
                    <h1 class="govuk-panel__title">
                        Request approved
                    </h1>
                    <div class="govuk-panel__body">
                        Request ID:<br><strong>@Model.DataShareRequestRequestId.ToUpper()</strong>
                    </div>
                </div>

                <p class="govuk-body">@Model.AcquirerOrganisationName has been told their request has been approved and you will contact them to discuss further.</p>

                <h2 class="govuk-heading-m">What happens next</h2>
                <p class="govuk-body">
                    Contact <a class="govuk-link" href="mailto:#">@Model.AcquirerUserEmailAddress</a> to start a discussion.
                </p>
            }

            <div class="govuk-button-group">
                <a asp-controller="DataRequest" asp-action="ReceivedRequests" class="govuk-link">Return to received requests</a>
            </div>
        </div>
    </div>
</div>