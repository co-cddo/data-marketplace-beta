@using Cddo.Data.Marketplace.UI.Configuration
@using Cddo.Data.Marketplace.UI.Controllers
@using Cddo.Data.Marketplace.UI.Pages.Shared
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Support";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>@pageTitle</title>
    @await Html.PartialAsync("_HeadPartial", new HeadPartialModel())
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("_HeaderPartial", new HeaderPartialModel())
    @await Html.PartialAsync("_NavbarPartial", new NavbarPartialModel())

    <main role="main" id="main-content">
        <div class="govuk-width-container govuk-phase-banner">
            <p class="govuk-phase-banner__content">
                <strong class="govuk-tag govuk-phase-banner__content__tag">
                    Beta
                </strong>
                <span class="govuk-phase-banner__text">
                    This is a new service – your <a class="govuk-link" href="https://docs.google.com/forms/d/e/1FAIpQLSforohZAzyIgaKnkthTDRWzpnrh10eqGmNZRSwOLZDE0DZYEQ/viewform">feedback</a> will help us to improve it.
                </span>
            </p>
        </div>
        <div class="govuk-width-container">
            <div class="govuk-main-wrapper">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-third">
                        <h2 class="govuk-heading-m">General</h2>
                        <ul class="govuk-list">
                            <li><a asp-controller="Support" asp-action="@nameof(SupportController.GetStarted)" class="govuk-link">Get started</a></li>
                            <li><a asp-controller="Support" asp-action="@nameof(SupportController.Roles)" class="govuk-link">Roles</a></li>
                            <li><a asp-controller="Support" asp-action="@nameof(SupportController.RequestingRestrictedData)" class="govuk-link">Requesting restricted data</a></li>
                            <li><a asp-controller="Support" asp-action="@nameof(SupportController.DataShareQuestions)" class="govuk-link">Data request questions</a></li>
                        </ul>
                        <h2 class="govuk-heading-m">Developers</h2>
                        <ul class="govuk-list">
                            <li><a asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)" class="govuk-link">API</a></li>
                            @if (ViewData["Tags"] != null && (List<TagLinks>)ViewData["Tags"] != null)
                            {
                                @foreach (var item in (List<TagLinks>)ViewData["Tags"])
                                {
                                    <li><a asp-controller="Support" class="govuk-link" asp-action="GetEndpointData" asp-route-apiPath="@item.TagLink" asp-route-operationId="@item.TagName">@item.TagLabel</a></li>
                                }
                            }
                            
                           @*  <li><a href="#" class="govuk-link">Search your datasets</a></li>
                            <li><a href="#" class="govuk-link">Submit dataset</a></li>
                            <li><a href="#" class="govuk-link">Get dataset</a></li>
                            <li><a href="#" class="govuk-link">Update dataset</a></li>
                            <li><a href="#" class="govuk-link">Delete dataset</a></li> *@
                        </ul>
                    </div>
                    <div class="govuk-grid-column-two-thirds">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </main>

    @await Html.PartialAsync("_FooterPartial", new FooterPartialModel())
    @await Html.PartialAsync("_ScriptsPartial", new ScriptsPartialModel())
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
