@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Header";
    var baseUrl = Context.Request.Cookies["BaseUrl"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>@pageTitle</title>
    @await Html.PartialAsync("_HeadPartial", new HeadPartialModel())
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("_CookieBannerPartial.cshtml", new CookieBannerPartialModel())
    @await Html.PartialAsync("_HeaderPartial", new HeaderPartialModel(baseUrl))
    @await Html.PartialAsync("_NavbarPartial", new NavbarPartialModel())

    <main role="main" id="main-content">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_FooterPartial", new FooterPartialModel())
    @await Html.PartialAsync("_ScriptsPartial", new ScriptsPartialModel())
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>