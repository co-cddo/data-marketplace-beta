@using Cddo.Data.Marketplace.UI.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<HotjarSettings> HotjarConfig
@{
    var analyticsCookiesAreAccepted = Context.Request.Cookies["cddo-analytics-cookies-acceptance"] == "True";
    var pageTitle = ViewData["Title"]?.ToString() ?? string.Empty;
}

@if (analyticsCookiesAreAccepted)
{
    @if (HotjarConfig.Value.HotjarEnabled)
    {
        <script nonce="@Context.Items["NETESCAPADES_NONCE"]">
            (function (h, o, t, j, a, r) {
                h.hj = h.hj || function () { (h.hj.q = h.hj.q || []).push(arguments) };
                h._hjSettings = { hjid: @HotjarConfig.Value.HotjarId, hjsv: 6 };
                a = o.getElementsByTagName('head')[0];
                r = o.createElement('script'); r.async = 1;
                r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
                a.appendChild(r);
            })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');
        </script>
    }
    @if (HotjarConfig.Value.GAEnabled)
    {
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@HotjarConfig.Value.GAEnvironment"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', '@HotjarConfig.Value.GAEnvironment', {
                'cookie_domain': '@HotjarConfig.Value.GACookieDomain'
            });
        </script>
    }
}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@(!string.IsNullOrWhiteSpace(pageTitle) ? $"{pageTitle} - " : "") Data Marketplace</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0c0c">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<link rel="manifest" href="~/assets/manifest.json">
<link rel="shortcut icon" sizes="16x16 32x32 48x48" href="~/assets/images/favicon.ico" type="image/x-icon">
<link rel="mask-icon" href="~/assets/images/govuk-icon-mask.svg" color="#0b0c0c">

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/govuk-frontend-5.7.1.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/chartjs/Chart.css" />