@using Cddo.Data.Marketplace.UI.Controllers
@model CookieBannerPartialModel

@{
    bool showCookieBanner = !Context.Request.Cookies.TryGetValue("cddo-analytics-cookies-acceptance", out _) ||
                            !Context.Request.Cookies.TryGetValue("cddo-sitesettings-cookies-acceptance", out _);

    const string tempCookiesAcceptanceDecisionName = "CookieAcceptanceDecision";
    var tempCookiesAcceptanceDecision = TempData[tempCookiesAcceptanceDecisionName];

    bool cookiesWereAccepted = tempCookiesAcceptanceDecision is bool and true;
    bool cookiesWereRejected = tempCookiesAcceptanceDecision is bool and false;
}

@if (showCookieBanner)
{
    <div class="govuk-cookie-banner" data-nosnippet aria-live="polite" aria-describedby="cookie-banner-description">
        <div class="govuk-cookie-banner__message govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h2 class="govuk-cookie-banner__heading govuk-heading-m" id="cookie-banner-description">
                        Cookies on the Data Marketplace
                    </h2>
                    <div class="govuk-cookie-banner__content">
                        <p class="govuk-body">We use some essential cookies to make this service work.</p>
                        <p class="govuk-body">We’d also like to use analytics cookies so we can understand how you use the service and make improvements.</p>
                    </div>
                </div>
            </div>
            <div class="govuk-button-group">
                <form asp-controller="Cookie" asp-action="@nameof(CookieController.ApplyCookiesAcceptanceDecisionFromBanner)" method="post" asp-route-AcceptAllCookiesDecision="True">
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Accept cookies
                    </button>
                </form>

                <form asp-controller="Cookie" asp-action="@nameof(CookieController.ApplyCookiesAcceptanceDecisionFromBanner)" method="post" asp-route-AcceptAllCookiesDecision="False">
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Reject cookies
                    </button>
                </form>

                <a class="govuk-link" asp-controller="About" asp-action="Cookies">View cookies</a>
            </div>
        </div>
    </div>
}

@if (cookiesWereAccepted)
{
   <section class="govuk-cookie-banner" data-nosnippet aria-live="polite">
        <div class="govuk-cookie-banner__message govuk-width-container" id="accept-cookie-confirmation">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-cookie-banner__content">
                        <p class="govuk-body">You’ve accepted additional cookies. You can <a class="govuk-link" href="/about/cookies" aria-label="Change cookie settings">change your cookie settings</a> at any time.</p>
                    </div>
                </div>
            </div>
            <div class="govuk-button-group">
                <form asp-controller="Cookie" asp-action="@nameof(CookieController.HideCookieBanner)" method="post">
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Hide cookie message
                    </button>
                </form>
            </div>
        </div>
    </section>
}
else if (cookiesWereRejected)
{
   <section class="govuk-cookie-banner" data-nosnippet aria-live="polite">
        <div class="govuk-cookie-banner__message govuk-width-container" id="reject-cookie-confirmation">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-cookie-banner__content">
                        <p class="govuk-body">You’ve rejected additional cookies. You can <a class="govuk-link" href="/about/cookies" aria-label="Change cookie settings">change your cookie settings</a> at any time.</p>
                    </div>
                </div>
            </div>
            <div class="govuk-button-group">
                <form asp-controller="Cookie" asp-action="@nameof(CookieController.HideCookieBanner)" method="post">
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Hide cookie message
                    </button>
                </form>
            </div>
        </div>
    </section>
}
