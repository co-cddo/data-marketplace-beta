@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Enums
@using Agm.Catalog.DotNet.Dto.Models.DataAssets.Profiles.DcatUk.V3_1
@using Cddo.Data.Marketplace.Api.Dto.Requests.Catalog.Questions
@using Cddo.Data.Marketplace.UI.Controllers

@model List<Distribution>

@{
    var identifier = ViewData["identifier"] as string;
    var fileDownloads = Model.Where(d => d.MediaType?.FirstOrDefault() == "File download").ToList();
    var apis = Model.Where(d => d.MediaType?.FirstOrDefault() == "API").ToList();
    var webpages = Model.Where(d => d.MediaType?.FirstOrDefault() == "text/html").ToList();
    var linksTitle = ViewData["LinksTitle"] ?? "Access link";
    var accessRights = ViewData["AccessRights"] ?? "";
}
<h1 class="govuk-heading-l">
    @linksTitle
</h1>



@if (linksTitle.ToString() == "Links" && Model.Count <= 0 && accessRights.ToString() == "OPEN")
{
    <div class="govuk-error-summary validation-summary-errors" data-module="govuk-error-summary">
        <div role="alert">
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>
                        <a asp-action="@nameof(CatalogDataDescriptionController.AddSupplyFormat)" asp-route-identifier="@identifier">Enter 1 or more links to access the data</a>
                    </li>

                </ul>
            </div>
        </div>
    </div>
}
@if (Model.Any())
{
    <p class="govuk-body">
        These links open in a new tab.
    </p>
}

@if (fileDownloads.Any())
{
    <h2 class="govuk-heading-m">
        Downloads
    </h2>
    <dl class="govuk-summary-list">
        @foreach (var distribution in fileDownloads)
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    <a target="_blank" href="@distribution.DownloadUrl" class="govuk-link">
                        @distribution.Title
                    </a>
                </dt>
                <dd class="govuk-summary-list__value">
                    @distribution.Format
                </dd>
                <dd class="govuk-summary-list__actions">
                    <ul class="govuk-summary-list__actions-list">
                        <li class="govuk-summary-list__actions-list-item">
                            <a class="govuk-link" asp-action="@nameof(CatalogDataDescriptionController.AddDistributionLinks)" asp-route-identifier="@identifier" asp-route-mediaType="@distribution.MediaType.FirstOrDefault()" asp-route-distributionId="@distribution.Id" asp-route-isEditMode="true">Change</a>
                        </li>
                        <li class="govuk-summary-list__actions-list-item">
                            <a class="govuk-link" asp-action="@nameof(CatalogDataDescriptionController.RemoveDistributionLinkConfirmation)" asp-route-identifier="@identifier" asp-route-distributionId="@distribution.Id" asp-route-title="@distribution.Title">Delete</a>
                        </li>
                    </ul>
                </dd>
            </div>
        }
    </dl>

}
@if (apis.Any())
{
    <h2 class="govuk-heading-m">
        API
    </h2>
    <dl class="govuk-summary-list">
        @foreach (var distribution in apis)
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    <a target="_blank" href="@distribution.AccessUrl" class="govuk-link">
                        @distribution.Title
                    </a>
                </dt>
                <dd class="govuk-summary-list__actions">
                    <ul class="govuk-summary-list__actions-list">
                        <li class="govuk-summary-list__actions-list-item">
                            <a class="govuk-link" asp-action="@nameof(CatalogDataDescriptionController.AddDistributionLinks)" asp-route-identifier="@identifier" asp-route-mediaType="@distribution.MediaType.FirstOrDefault()" asp-route-distributionId="@distribution.Id" asp-route-isEditMode="true">Change</a>
                        </li>
                        <li class="govuk-summary-list__actions-list-item">
                            <a class="govuk-link" asp-action="@nameof(CatalogDataDescriptionController.RemoveDistributionLinkConfirmation)" asp-route-identifier="@identifier" asp-route-distributionId="@distribution.Id" asp-route-title="@distribution.Title">Delete</a>
                        </li>
                    </ul>
                </dd>
            </div>
        }
    </dl>

}
@if (webpages.Any())
{
    <h2 class="govuk-heading-m">
        Webpages
    </h2>
    <dl class="govuk-summary-list">
        @foreach (var distribution in webpages)
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    <a target="_blank" href="@distribution.DownloadUrl" class="govuk-link">
                        @distribution.Title
                    </a>
                </dt>
                <dd class="govuk-summary-list__actions">
                    <ul class="govuk-summary-list__actions-list">
                        <li class="govuk-summary-list__actions-list-item">
                            <a class="govuk-link" asp-action="@nameof(CatalogDataDescriptionController.AddDistributionLinks)" asp-route-identifier="@identifier" asp-route-mediaType="@distribution.MediaType.FirstOrDefault()" asp-route-distributionId="@distribution.Id" asp-route-isEditMode="true">Change</a>
                        </li>
                        <li class="govuk-summary-list__actions-list-item">
                            <a class="govuk-link" asp-action="@nameof(CatalogDataDescriptionController.RemoveDistributionLinkConfirmation)" asp-route-identifier="@identifier" asp-route-distributionId="@distribution.Id" asp-route-title="@distribution.Title">Delete</a>
                        </li>
                    </ul>
                </dd>
            </div>
        }
    </dl>


}
@if (linksTitle != "Links")
{
    <div class="govuk-form-group">
        <a class="govuk-button govuk-button--secondary" asp-action="@nameof(CatalogDataDescriptionController.AddSupplyFormat)" asp-route-identifier="@identifier" role="button" draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-govuk-button-init="">
            Add another access method
        </a>

    </div>
}

<style scoped>
    .govuk-summary-list__key {
        font-weight: 400;
    }
</style>
