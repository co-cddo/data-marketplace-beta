@using Cddo.Data.Marketplace.Api.Dto.Responses.ClientAuth
@using Cddo.Data.Marketplace.UI.Controllers
@model ClientAuthCredentialsResponse
@{
    var errorMessage = ViewData.ModelState[nameof(Model.AppName)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasNameError = ViewData.ModelState[nameof(Model.AppName)]?.Errors.Any() == true;
}
<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form class="form" asp-controller="Developer" asp-action="@nameof(DeveloperController.UpdateApiName)" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_ErrorSummaryPartial", ViewData.ModelState)
                <div class="govuk-form-group @(hasNameError ? "govuk-form-group--error" : "")">
                    <label class="govuk-label govuk-label--l" for="AppName">
                        Name
                    </label>
                    <div id="AppName-hint" class="govuk-hint">
                        What will these credentials be used for? This is just for your reference.
                    </div>
                    @if (hasNameError)
                    {
                        <p id="Title-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span> @errorMessage
                        </p>
                    }
                    <input class="govuk-input govuk-input--width-20 @(hasNameError ? "govuk-input--error" : "")" id="AppName" name="AppName" type="text" value="@Model.AppName" aria-describedby="AppName-hint">
                </div>
                <button class="govuk-button" data-module="govuk-button">Save changes</button>
            </form>
            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)">
                    API documentation
                </a>
            </p>
        </div>
    </div>
</div>
