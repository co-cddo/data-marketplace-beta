@using Cddo.Data.Marketplace.Api.Dto.Responses.ClientAuth
@using Cddo.Data.Marketplace.UI.Controllers
@model ClientAuthCredentialsResponse

@{
    // Default expiration to 6 months from now if not set
    var defaultExpiration = DateTime.UtcNow.AddMonths(6);
    var expiration = Model.Expiration ?? defaultExpiration;

    var day = expiration.Day;
    var month = expiration.Month;
    var year = expiration.Year;

    var dayError = ViewData.ModelState["expiryDay"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var monthError = ViewData.ModelState["expiryMonth"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var yearError = ViewData.ModelState["expiryYear"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form class="form" asp-controller="Developer" asp-action="@nameof(DeveloperController.UpdateApiExpiry)" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_ErrorSummaryPartial", ViewData.ModelState)
                @if (dayError != null)
                {
                    <span class="govuk-error-message">Please enter a valid day</span>
                }
                @if (monthError != null)
                {
                    <span class="govuk-error-message">Please enter a valid month</span>
                }
                @if (yearError != null)
                {
                    <span class="govuk-error-message">Please enter a valid year (e.g., 2025)</span>
                }
                <div class="govuk-form-group @(dayError != null ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" role="group">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">@Model.AppName – Expiry date</h1>
                        </legend>

                        <div class="govuk-date-input" id="expiry">
                            <div class="govuk-date-input__item">
                                <div class="govuk-form-group">
                                    <label class="govuk-label govuk-date-input__label" for="expiry-day">Day</label>
                                    <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(dayError != null ? "govuk-input--error" : "")"
                                           id="expiry-day" name="expiryDay" type="text" value="@(day!=0&& dayError == null?@day:"")" inputmode="numeric" aria-describedby="expiry-day-error">
                                </div>
                            </div>

                            <div class="govuk-date-input__item">
                                <div class="govuk-form-group">
                                    <label class="govuk-label govuk-date-input__label" for="expiry-month">Month</label>
                                    <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(monthError != null ? "govuk-input--error" : "")"
                                           id="expiry-month" name="expiryMonth" type="text" value="@(month!=0 && monthError == null?@month:"")" inputmode="numeric" aria-describedby="expiry-month-error">
                                </div>
                            </div>

                            <div class="govuk-date-input__item">
                                <div class="govuk-form-group">
                                    <label class="govuk-label govuk-date-input__label" for="expiry-year">Year</label>
                                    <input class="govuk-input govuk-date-input__input govuk-input--width-4 @(yearError != null ? "govuk-input--error" : "")"
                                           id="expiry-year" name="expiryYear" type="text" value="@(year!=0&& yearError == null?@year:"")" inputmode="numeric" aria-describedby="expiry-year-error">
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <button class="govuk-button" data-module="govuk-button">Save changes</button>
            </form>

            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)">
                    API documentation
                </a>
            </p>
        </div>
    </div>
</div>
