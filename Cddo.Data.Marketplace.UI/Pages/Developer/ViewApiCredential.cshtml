@using Cddo.Data.Marketplace.UI.Controllers
@model Cddo.Data.Marketplace.Api.Dto.Responses.ClientAuth.ClientAuthCredentialsResponse
@{
}

<a class="govuk-back-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.ApiCredentials)">API credentials</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @if (ViewBag.IsSuccess != null && ViewBag.IsSuccess)
            {
                <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
                    <div class="govuk-notification-banner__header">
                        <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                            Success
                        </h2>
                    </div>
                    <div class="govuk-notification-banner__content">
                        <p class="govuk-notification-banner__heading">
                            Changes saved
                        </p>
                    </div>
                </div>
            }
            <h1 class="govuk-heading-l">
                <span class="govuk-caption-l">API credentials</span>
                @Model.AppName
            </h1>
            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Name
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @Model.AppName
                    </dd>
                    <dd class="govuk-summary-list__actions">
                        @if (Model.Status?.ToLower() != "revoked")
                        {
                            <a class="govuk-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.GotoUpdateApiName)" asp-route-id="@Model.Id">Change<span class="govuk-visually-hidden"> name</span></a>
                        }
                    </dd>
                </div>

                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Scopes
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @{
                            var formattedScopes = string.Join(", ", Model.Scopes?.Split(',')
                            .Select(s => s.Trim().Substring(0, 1).ToUpper() + s.Trim().Substring(1).ToLower()));
                        }
                        @formattedScopes
                    </dd>

                    <dd class="govuk-summary-list__actions">
                        @if (Model.Status?.ToLower() != "revoked")
                        {
                            <a class="govuk-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.GotoUpdateApiScope)" asp-route-id="@Model.Id">Change<span class="govuk-visually-hidden"> scopes</span></a>
                        }
                    </dd>
                </div>

                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Expiry
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @if (Model.Expiration.HasValue)
                        {
                            @Model.Expiration.Value.ToString("%d/%M/yyyy")
                        }
                    </dd>
                    <dd class="govuk-summary-list__actions">
                        @if (Model.Status?.ToLower() != "revoked")
                        {
                            <a class="govuk-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.GotoUpdateApiExpiry)" asp-route-id="@Model.Id">Change<span class="govuk-visually-hidden"> expiry</span></a>
                        }
                    </dd>
                </div>

                <div class="govuk-summary-list__row govuk-summary-list__row--no-actions">
                    <dt class="govuk-summary-list__key">
                        Environment
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @{
                            var environmentLabel = Model.Environment?.ToLower() == "test" ? "Sandbox" : Model.Environment;
                        }
                        @environmentLabel
                    </dd>
                </div>
                <div class="govuk-summary-list__row govuk-summary-list__row--no-actions">
                    <dt class="govuk-summary-list__key">
                        State
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @{
                            var status = Model.Status;
                            if (!string.IsNullOrEmpty(status))
                            {
                                status = status.Substring(0, 1).ToUpper() + status.Substring(1).ToLower();
                            }
                        }
                        @status
                    </dd>
                </div>
            </dl>
            @if (Model.Status?.ToLower() != "revoked")
            {
                <p class="govuk-body">
                    <a class="govuk-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.GotoRevokeCredentials)" asp-route-id="@Model.Id">
                        Revoke these credentials
                    </a>
                </p>
            }

            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)">
                    API documentation
                </a>
            </p>
        </div>
    </div>
</div>
