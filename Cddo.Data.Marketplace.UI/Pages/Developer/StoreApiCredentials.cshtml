@using Cddo.Data.Marketplace.Api.Dto.Responses.ClientAuth
@using Cddo.Data.Marketplace.UI.Controllers
@model ClientAuthCredentialsResponse
@{
}

<a class="govuk-back-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.ApiCredentials)">API credentials</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                Store your credentials
            </h1>

            <div class="govuk-inset-text">
                Copy your client ID and secret somewhere safe. You will not be able to see them again after you leave this page.
            </div>

            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Client ID
                    </dt>
                    <dd class="govuk-summary-list__value" id="client-id">
                        @Model.ClientId
                    </dd>
                    <dd class="govuk-summary-list__actions">
                        <button id="copy-client-id" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
                            Copy
                        </button>
                    </dd>
                </div>

                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Client secret
                    </dt>
                    <dd class="govuk-summary-list__value" id="client-secret">
                        @Model.ClientSecret
                    </dd>
                    <dd class="govuk-summary-list__actions">
                        <button id="copy-client-secret" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
                            Copy
                        </button>
                    </dd>
                </div>
            </dl>
            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)">
                    API documentation
                </a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("copy-client-id").addEventListener("click", function () {
                const clientId = document.getElementById("client-id").innerText;
                navigator.clipboard.writeText(clientId).catch(err => {
                    console.error("Error copying Client ID: ", err);
                });
            });

            document.getElementById("copy-client-secret").addEventListener("click", function () {
                const clientSecret = document.getElementById("client-secret").innerText;
                navigator.clipboard.writeText(clientSecret).catch(err => {
                    console.error("Error copying Client Secret: ", err);
                });
            });
        });
    </script>
}
