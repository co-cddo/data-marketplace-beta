@using Cddo.Data.Marketplace.Api.Dto.Responses.ClientAuth
@using Cddo.Data.Marketplace.UI.Controllers
@model ClientAuthCredentialsResponse
@{
}
<a class="govuk-back-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.ApiCredentials)">API credentials</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                Are you sure you want to revoke these credentials?
            </h1>

            <p class="govuk-body">Name: @Model.AppName</p>

            <form asp-controller="Developer" asp-action="@nameof(DeveloperController.RevokeCredentials)" method="post" asp-route-id="@Model.Id">
                <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button" data-govuk-button-init="">
                    Revoke credentials
                </button>
            </form>
            <p class="govuk-body">
                <a asp-controller="Developer" asp-action="@nameof(DeveloperController.ApiCredentials)" class="govuk-link">
                    Cancel and return to API credentials
                </a>
            </p>
        </div>
    </div>
</div>