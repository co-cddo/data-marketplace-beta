@using Cddo.Data.Marketplace.Api.Dto.Responses.ClientAuth
@using Cddo.Data.Marketplace.UI.Controllers
@model List<ClientAuthCredentialsResponse>

@{
    ViewData["Title"] = "Support - API Keys";
}

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                API credentials
            </h1>

            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)">Data Marketplace API documentation</a>
            </p>

            <div class="govuk-!-margin-top-6">
                <a class="govuk-button" asp-controller="Developer" asp-action="@nameof(DeveloperController.GotoCreateApiCredential)">
                    Create new API credentials
                </a>
            </div>

            @if (Model != null && Model.Any())
            {
                foreach (var credential in Model)
                {
                    <div class="govuk-!-padding-top-4 govuk-!-margin-bottom-4" style="border-top: 1px solid #b1b4b6">
                        <h2 class="govuk-heading-m">
                            <a class="govuk-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.GetApiCredentialById)" asp-route-id="@credential.Id">@credential.AppName</a>
                        </h2>

                        <dl class="govuk-summary-list govuk-summary-list--no-border">
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Scopes
                                </dt>
                                <dd class="govuk-summary-list__value">
                                        @{
                                            var formattedScopes = string.Join(", ", credential.Scopes?
                                            .Split(',')
                                            .Select(s => s.Trim())
                                            .Where(s => !string.IsNullOrEmpty(s)) 
                                            .Select(s => char.ToUpper(s[0]) + s.Substring(1).ToLower())); 
                                        }
                                        @formattedScopes
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Expiry
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @if (credential.Expiration.HasValue)
                                    {
                                        @credential.Expiration.Value.ToString("%d/%M/yyyy")
                                    }
                                    else
                                    {
                                        <span>Not set</span>
                                    }
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Environment
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @{
                                        var environmentLabel = credential.Environment?.ToLower() == "test" ? "Sandbox" : credential.Environment;
                                    }
                                    @environmentLabel
                                </dd>
                            </div>
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    State
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @{
                                        var status = credential.Status;
                                        if (!string.IsNullOrEmpty(status))
                                        {
                                            status = status.Substring(0, 1).ToUpper() + status.Substring(1).ToLower();
                                        }
                                    }
                                    @status
                                </dd>
                            </div>
                        </dl>
                    </div>
                }
            }
            
        </div>
    </div>
</div>
