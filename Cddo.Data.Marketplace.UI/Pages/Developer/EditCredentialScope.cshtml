@using Cddo.Data.Marketplace.Api.Dto.Responses.ClientAuth
@using Cddo.Data.Marketplace.UI.Controllers

@model ClientAuthCredentialsResponse
@{
    var scopes = Model.Scopes.Split(',');
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form class="form" asp-controller="Developer" asp-action="@nameof(DeveloperController.UpdateApiScope)" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_ErrorSummaryPartial", ViewData.ModelState)

                <div class="govuk-form-group @(ViewData.ModelState.ErrorCount>0 ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">
                                @Model.AppName - Scopes
                            </h1>
                        </legend>
                        <div id="Scopes" class="govuk-checkboxes" data-module="govuk-checkboxes">
                            @Html.ValidationMessage("Scopes", null, new { @class = "govuk-error-message" })
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="scopes" name="scopes" type="checkbox" value="discover" @(scopes.Contains("discover") ? "checked" : "") aria-describedby="scopes-item-hint">
                                <label class="govuk-label govuk-checkboxes__label" for="scopes">
                                    discover
                                </label>
                                <div id="scopes-item-hint" class="govuk-hint govuk-checkboxes__hint">
                                    Search and retrieve your metadata records.
                                </div>
                            </div>

                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="scopes-2" name="scopes" type="checkbox" value="publish" @(scopes.Contains("publish") ? "checked" : "") aria-describedby="scopes-2-item-hint">
                                <label class="govuk-label govuk-checkboxes__label" for="scopes-2">
                                    publish
                                </label>

                                <div id="scopes-2-item-hint" class="govuk-hint govuk-checkboxes__hint">
                                    Publish and update your metadata records.
                                </div>

                            </div>

                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="scopes-3" name="scopes" type="checkbox" value="delete" @(scopes.Contains("delete") ? "checked" : "") aria-describedby="scopes-3-item-hint">
                                <label class="govuk-label govuk-checkboxes__label" for="scopes-3">
                                    delete
                                </label>

                                <div id="scopes-3-item-hint" class="govuk-hint govuk-checkboxes__hint">
                                    Delete your metadata records.
                                </div>

                            </div>
                        </div>
                    </fieldset>
                </div>
                <button class="govuk-button" data-module="govuk-button" data-govuk-button-init="">Save changes</button>
            </form>

            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)">
                    API documentation
                </a>
            </p>
        </div>
    </div>
</div>
