@using Cddo.Data.Marketplace.Api.Dto.Requests.ClientAuth
@using Cddo.Data.Marketplace.UI.Controllers
@model ClientAuthCredentialsRequest
@{
}
<a class="govuk-back-link" asp-controller="Developer" asp-action="@nameof(DeveloperController.ApiCredentials)">API credentials</a>

<div class="govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">Create new API credentials</h1>
            <form asp-controller="Developer" asp-action="@nameof(DeveloperController.CreateApiCredential)" method="post">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_ErrorSummaryPartial", ViewData.ModelState)

                <!-- App Name -->
                <div class="govuk-form-group @(ViewData.ModelState.ContainsKey(nameof(ClientAuthCredentialsRequest.AppName)) && ViewData.ModelState[nameof(ClientAuthCredentialsRequest.AppName)].Errors.Any() ? "govuk-form-group--error" : "")">
                    <label class="govuk-label govuk-label--s" for="AppName">
                        Name
                    </label>
                    <div id="app-name-hint" class="govuk-hint">
                        What will these credentials be used for? This is just for your reference.
                    </div>
                    @Html.ValidationMessageFor(model => model.AppName, "", new { @class = "govuk-error-message" })
                    <input class="govuk-input govuk-input--width-20" id="AppName" name="@nameof(ClientAuthCredentialsRequest.AppName)" type="text" aria-describedby="app-name-hint" value="@Model?.AppName">
                </div>

                <!-- Environment -->
                <div id="Environment" class="govuk-form-group @(ViewData.ModelState.ContainsKey(nameof(ClientAuthCredentialsRequest.Environment)) && ViewData.ModelState[nameof(ClientAuthCredentialsRequest.Environment)].Errors.Any() ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                            Environment
                        </legend>
                        @Html.ValidationMessageFor(model => model.Environment, "", new { @class = "govuk-error-message" })
                        <div class="govuk-radios" data-module="govuk-radios" data-govuk-radios-init="">
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="app-environment" name="@nameof(ClientAuthCredentialsRequest.Environment)" type="radio" value="Test" checked="checked"
                                @if (Model?.Environment == "Test")
                                {
                                    <text>checked="checked"</text>
                                }
                                aria-describedby="app-environment-test-hint">
                                <label class="govuk-label govuk-radios__label" for="app-environment">
                                    Sandbox
                                </label>
                                <div id="app-environment-test-hint" class="govuk-hint govuk-radios__hint">
                                    Use this environment for testing.
                                </div>
                            </div>

                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="app-environment-2" name="@nameof(ClientAuthCredentialsRequest.Environment)" type="radio" value="Production"
                                @if (Model?.Environment == "Production")
                                {
                                    <text>checked="checked"</text>
                                }
                                aria-describedby="app-environment-prod-hint">
                                <label class="govuk-label govuk-radios__label" for="app-environment-2">
                                    Production
                                </label>

                                <div id="app-environment-prod-hint" class="govuk-hint govuk-radios__hint">
                                    Use this environment for publishing your records.
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <!-- Scope -->
                <div id="ScopeList" class="govuk-form-group @(ViewData.ModelState.ContainsKey(nameof(ClientAuthCredentialsRequest.ScopeList)) && ViewData.ModelState[nameof(ClientAuthCredentialsRequest.ScopeList)].Errors.Any() ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                            Scopes
                        </legend>
                        <div id="scope-hint" class="govuk-hint">
                            Select one or more.
                        </div>
                        @Html.ValidationMessageFor(model => model.ScopeList, "", new { @class = "govuk-error-message" })
                        <div class="govuk-form-group">                            
                            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input" id="scope-1" name="@nameof(ClientAuthCredentialsRequest.ScopeList)" type="checkbox" value="discover">
                                    <label class="govuk-label govuk-checkboxes__label" for="scope-1">
                                        Discover
                                    </label>
                                    <div id="app-scopes-item-hint-1" class="govuk-hint govuk-checkboxes__hint">
                                        Search and retrieve your listings.
                                    </div>
                                </div>
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input" id="scope-2" name="@nameof(ClientAuthCredentialsRequest.ScopeList)" type="checkbox" value="publish">
                                    <label class="govuk-label govuk-checkboxes__label" for="scope-2">
                                        Publish
                                    </label>
                                    <div id="app-scopes-item-hint" class="govuk-hint govuk-checkboxes__hint">
                                        Publish and update your listings.
                                    </div>
                                </div>
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input" id="scope-3" name="@nameof(ClientAuthCredentialsRequest.ScopeList)" type="checkbox" value="delete">
                                    <label class="govuk-label govuk-checkboxes__label" for="scope-3">
                                        Delete
                                    </label>
                                    <div id="app-scopes-item-hint" class="govuk-hint govuk-checkboxes__hint">
                                        Delete your listings.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <button class="govuk-button" data-module="govuk-button" data-govuk-button-init="">Continue</button>
            </form>
            <p class="govuk-body">
                <a class="govuk-link" asp-controller="Support" asp-action="@nameof(SupportController.ApiSupport)">
                    API documentation
                </a>
            </p>
        </div>
    </div>
</div>
