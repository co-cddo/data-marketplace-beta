@using Cddo.Data.Marketplace.UI.Controllers
@model Cddo.Data.Marketplace.UI.Pages.Support.IndexModel
@{
    ViewData["Title"] = "Support";
    Layout = "~/Pages/Shared/_SupportLayout.cshtml";
}

<div>
    <h1 class="govuk-heading-l">Get started</h1>

    <p class="govuk-body">
        The Data Marketplace is for people who work in government organisations.
    </p>

    <p class="govuk-body">
        It allows you to search a catalogue of data listings and find government data that may be useful to your project or policy.
    </p>

    <p class="govuk-body">The catalogue includes listings for:</p>

    <ul class="govuk-list govuk-list--bullet">
        <li>public data – which you can access by following the link provided</li>
        <li>restricted data – which you can request from the organisation that owns the data</li>
    </ul>

    <p class="govuk-body">
        This is a new service, still in private beta. Currently it’s only available to central government departments and some other organisations.
    </p>

    <p class="govuk-body">
        <a href="https://alphagov.github.io/data-marketplace-info/domains/" class="govuk-link">Check which organisations have joined</a> already. If you’re from a different organisation and you want to use the Data Marketplace, you can <a href="https://datamarketplace.gov.uk/organisationaccess/organisation-access-request" class="govuk-link">request access</a>.
    </p>

    <h2 class="govuk-heading-m">Create an account</h2>

    <p class="govuk-body">
        You need an account to access the catalogue and other features in the Data Marketplace.
    </p>

    <p class="govuk-body">To set up your account, you must:</p>

    <ul class="govuk-list govuk-list--bullet">
        <li>work for a government organisation</li>
        <li>have a government email address</li>
    </ul>

    <p class="govuk-body">Go to the <a href="/Auth/SignIn" class="govuk-link">sign in page</a>, enter your email address and continue.</p>

    <p class="govuk-body">You’ll then go through your regular government sign-in process.</p>

    <p class="govuk-body">You can also <a asp-controller="Support" asp-action="@nameof(SupportController.Roles)" class="govuk-link">request additional roles</a> for your account to approve data requests or publish listings of your organisation’s data.</p>

    <h2 class="govuk-heading-m">Start using the Data Marketplace</h2>

    <p class="govuk-body">
        Once you’ve signed in, you can <a asp-controller="CatalogData" asp-action="@nameof(CatalogDataController.StartCddoDataAssetsSearch)" class="govuk-link">explore the catalogue</a> and find data you’re interested in.
    </p>

    <h2 class="govuk-heading-m">Get in touch</h2>

    <p class="govuk-body">
        If you’ve got a question, suggestion or need support, please contact us by emailing: <a href="mailto:datamarketplace@digital.cabinet-office.gov.uk" class="govuk-link">datamarketplace@digital.cabinet-office.gov.uk</a>.
    </p>
</div>
