@using Agrimetrics.DataShare.Api.Dto.Models.Questions.QuestionParts.ResponseFormats;
@using Agrimetrics.DataShare.Api.Dto.Models.DataShareRequests.Answers.DataShareRequestQuestionAnswers

@model QuestionPartResponseModel
@{
    var questionPartId = Model.QuestionPartId;
    var responseFormat = Model.ResponseFormat;

    var attachRemoveButton = Model.AttachRemoveButton;
    var responseItem = Model.ResponseItem;
    var validationErrors = Model.ValidationErrors;

    var maxResponseLength = Model.MaxResponseLength;
}

<div class="govuk-form-group govuk-character-count @(validationErrors.Any() ? "govuk-form-group--error" : "")" data-module="govuk-character-count" data-maxlength="@maxResponseLength">
    
    @if (@validationErrors.Any())
    {
        <p class="govuk-error-message">
            <span class="govuk-visually-hidden">Error:</span>
            @for (var errorIndex = 0; errorIndex < @validationErrors.Count; errorIndex++)
            {
                @validationErrors[errorIndex]

                @(errorIndex < @validationErrors.Count - 1 ? "," : "")
            }
        </p>
    }

    @switch (@responseFormat)
    {
        case QuestionPartResponseFormatType.Text:
            await Html.RenderPartialAsync("~/Pages/DataShare/_Partial/_ResponseFormats/_QuestionPartResponseItemFreeFormText.cshtml", responseItem);
            break;

        case QuestionPartResponseFormatType.Date:
            await Html.RenderPartialAsync("~/Pages/DataShare/_Partial/_ResponseFormats/_QuestionPartResponseItemFreeFormDate.cshtml", responseItem);
            break;

        case QuestionPartResponseFormatType.Country:
            await Html.RenderPartialAsync("~/Pages/DataShare/_Partial/_ResponseFormats/_QuestionPartResponseItemFreeFormCountry.cshtml", responseItem);
            break;

        case QuestionPartResponseFormatType.ReadOnly:
            await Html.RenderPartialAsync("~/Pages/DataShare/_Partial/_ResponseFormats/_QuestionPartResponseItemReadOnly.cshtml", responseItem);
            break;

        case QuestionPartResponseFormatType.SelectSingle:
            await Html.RenderPartialAsync("~/Pages/DataShare/_Partial/_ResponseFormats/_QuestionPartResponseItemOptionSelectionSingleValue.cshtml", responseItem);
            break;

        case QuestionPartResponseFormatType.SelectMulti:
            await Html.RenderPartialAsync("~/Pages/DataShare/_Partial/_ResponseFormats/_QuestionPartResponseItemOptionSelectionMultiValue.cshtml", responseItem);
            break;
    }
    
    @if (attachRemoveButton)
    {
        <button class="govuk-button govuk-button--secondary govuk-!-margin-top-2 remove-multiple-answer" data-container="@(questionPartId)-responses-container">Remove</button>
    }
</div>