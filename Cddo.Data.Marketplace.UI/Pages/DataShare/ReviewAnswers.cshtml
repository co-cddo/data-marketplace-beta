@using Agrimetrics.DataShare.Api.Dto.Models.DataShareRequests
@using Agrimetrics.DataShare.Api.Dto.Models.Questions.QuestionParts.ResponseFormats
@using Agrimetrics.DataShare.Api.Dto.Models.DataShareRequests.Answers.DataShareRequestAnswerSummaries
@using Cddo.Data.Marketplace.UI.Pages.DataShare
@using Cddo.Data.Marketplace.UI.Pages.DataShare._Partial

@model ReviewAnswersModel
@{
    ViewData["Title"] = "Review Answers";

    var answersSummary = Model.AnswersSummary;
    var dataShareRequestAuditLog = Model.DataShareRequestAuditLog;

    var dataShareRequestId = @answersSummary.DataShareRequestId;
    var requestStatus = @answersSummary.DataShareRequestStatus;

    var requestCanBeModified = requestStatus is DataShareRequestStatus.Draft or DataShareRequestStatus.Returned;
    var requestCanBeCancelled = requestStatus is DataShareRequestStatus.Submitted or DataShareRequestStatus.InReview;
}

@functions {

    public static string FormatFreeFormDate(string? dateString)
    {
        if (string.IsNullOrWhiteSpace(dateString))
            return "N/A";

        var yearPart = dateString.Substring(0, 4);
        var monthPart = dateString.Substring(4, 2);
        var dayPart = dateString.Substring(6, 2);

        return dayPart + '/' + monthPart + '/' + yearPart;
    }

    public static string PrettifyString(string? input)
    {
        if (input == null)
        {
            return "";
        }

        return string.Join(" ", input.Split('-').Select(w => char.ToUpper(w[0]) + w.Substring(1)));
    }
}

<div class="govuk-width-container">
    
    @if (requestCanBeModified)
    {
        <a class="govuk-back-link" asp-controller="DataRequest" asp-action="RequestTasks" asp-route-requestId="@dataShareRequestId">Back</a>
    }
    else
    {
        <a class="govuk-back-link" asp-controller="DataRequest" asp-action="CreatedRequests">Back</a>
    }

    <div class="govuk-main-wrapper govuk-main-wrapper--l">
        <div class="govuk-grid-row">

            @switch (@requestStatus)
            {
                case DataShareRequestStatus.Accepted:
                    <div class="govuk-panel govuk-panel--confirmation">
                        <h1 class="govuk-panel__title">
                            Request approved
                        </h1>
                        <div class="govuk-panel__body">
                            @answersSummary.SubmissionResponseFromSupplier
                        </div>
                    </div>
                    break;

                case DataShareRequestStatus.Rejected:
                    <div class="govuk-panel govuk-panel--confirmation">
                        <h1 class="govuk-panel__title">
                            Request rejected
                        </h1>
                        <div class="govuk-panel__body">
                            @answersSummary.SubmissionResponseFromSupplier
                        </div>
                    </div>
                    break;

                case DataShareRequestStatus.Cancelled:
                    <div class="govuk-panel govuk-panel--confirmation">
                        <h1 class="govuk-panel__title">
                            Request was cancelled
                        </h1>
                    </div>
                    break;
            }

            @if (dataShareRequestAuditLog.AuditLogEntries?.Any() == true)
            {
                await Html.RenderPartialAsync("~/Pages/DataShare/_Partial/_AuditLogReturnComments.cshtml", new AuditLogReturnCommentsModel
                {
                    DataShareRequestAuditLog = @dataShareRequestAuditLog
                });
            }

            <div class="govuk-grid-column-two-thirds">
                <span class="govuk-caption-l">Draft data request</span>

                @if (@requestCanBeModified)
                {
                    <h1 class="govuk-heading-l">Check your answers before submitting your request</h1>
                }
            </div>

            <div class="govuk-grid-column-full">
                @foreach (var answerSection in answersSummary.SummarySections.OrderBy(x => x.OrderWithinSummary))
                {
                    <h2 class="govuk-heading-m">@answerSection.SectionHeader</h2>

                    <dl class="govuk-summary-list govuk-!-margin-bottom-9">
                        @foreach (var answer in answerSection.SummaryQuestionGroups.OrderBy(x => x.OrderWithinSection))
                        {
                            var mainQuestionParts = answer.MainQuestionSummary.SummaryQuestionParts.OrderBy(x => x.OrderWithinQuestion);
                            var backingQuestionParts = answer.BackingQuestionSummaries.SelectMany(x => x.SummaryQuestionParts.OrderBy(x => x.OrderWithinQuestion));

                            <div class="govuk-summary-list__row">
                                
                                <dt class="govuk-summary-list__key">
                                    @mainQuestionParts.FirstOrDefault()?.QuestionPartText
                                </dt>

                                <dd class="govuk-summary-list__value">
                                    @foreach (var mainQuestionPart in mainQuestionParts)
                                    {
                                        @foreach (var responseItem in mainQuestionPart.Responses
                                       .OrderBy(x => x.OrderWithinQuestionPartAnswer)
                                       .Select(response => response.QuestionPartAnswerResponseItem))
                                        {
                                            @switch (responseItem.InputType)
                                            {
                                                case QuestionPartResponseInputType.FreeForm:
                                                    var freeFormResponseItem = (DataShareRequestAnswersSummaryQuestionPartAnswerResponseItemFreeForm)responseItem;
                                                    switch (mainQuestionPart.ResponseFormatType)
                                                    {
                                                        case QuestionPartResponseFormatType.Text:
                                                            <p>@Html.Raw(freeFormResponseItem.AnswerValue.ReplaceLineEndings().Replace(Environment.NewLine, "<br/>"))</p>
                                                            break;

                                                        case QuestionPartResponseFormatType.Date:
                                                            <p>@FormatFreeFormDate(freeFormResponseItem.AnswerValue)</p>
                                                            break;
                                                    }
                                                    break;

                                                case QuestionPartResponseInputType.OptionSelection:
                                                    var optionSelectionResponseItem = (DataShareRequestAnswersSummaryQuestionPartAnswerResponseOptionSelection)responseItem;
                                                    foreach (var selectedOption in optionSelectionResponseItem.SelectedOptions.OrderBy(x => x.OrderWithinAnswerPart))
                                                    {
                                                        <p>
                                                            @selectedOption.SelectionOptionText
                                                            @if (selectedOption.SupplementaryAnswerText != null)
                                                            {
                                                                <ul class="govuk-list govuk-list--bullet govuk-body-s caption-color">
                                                                    <li><i>@selectedOption.SupplementaryAnswerText</i></li>
                                                                </ul>
                                                            }
                                                        </p>
                                                    }
                                                    break;
                                            }
                                        }
                                    }


                                    @foreach (var backingQuestionPart in backingQuestionParts)
                                    {
                                        @if (@backingQuestionPart.MultipleResponsesAllowed && backingQuestionPart.Responses.Any())
                                        {
                                            <p class="govuk-body-s caption-color">@PrettifyString(@backingQuestionPart.MultipleResponsesCollectionHeaderIfMultipleResponsesAllowed):</p>
                                            <ul class="govuk-list govuk-list--bullet govuk-body-s caption-color">
                                                @foreach (var freeFormResponseItem in backingQuestionPart.Responses
                                               .OrderBy(x => x.OrderWithinQuestionPartAnswer)
                                               .Select(response => response.QuestionPartAnswerResponseItem)
                                               .OfType<DataShareRequestAnswersSummaryQuestionPartAnswerResponseItemFreeForm>())
                                                {
                                                    <li>@freeFormResponseItem.AnswerValue</li>
                                                }
                                            </ul>
                                        }
                                    }
                                </dd>
                                
                                <dd class="govuk-summary-list__actions">
                                    @if (@requestCanBeModified)
                                    {
                                        <a class="govuk-link" asp-controller="DataRequest" asp-action="RequestQuestion" asp-route-questionId="@answer.MainQuestionSummary.QuestionId" asp-route-requestId="@dataShareRequestId">Change</a>
                                    }
                                </dd>

                            </div>
                        }
                    </dl>
                }

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        <div class="govuk-button-group govuk-!-static-margin-top-9">

                            <form method="post" novalidate>
                                @if (@requestCanBeModified)
                                {
                                   @*  <h2 class="govuk-heading-m">Now send your application</h2>
                                    <p class="govuk-body">By submitting this application you are confirming that, to the best of your knowledge, the details you are providing are correct.</p>
 *@
                                    <input type="hidden" name="answers-checked" value="true">
                                    <button type="submit" class="govuk-button" data-module="govuk-button" asp-controller="DataRequest" asp-action="RequestSubmitDataShareRequest" asp-route-requestId="@dataShareRequestId">
                                        Submit data request
                                    </button>
                                }

                                @if (@requestCanBeCancelled)
                                {
                                    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button" asp-controller="DataRequest" asp-action="CancelCreatedRequest" asp-route-requestId="@dataShareRequestId">
                                        Cancel request
                                    </button>
                                }

                              @*   @if (@requestCanBeModified)
                                {
                                    <a class="govuk-link" asp-controller="DataRequest" asp-action="RequestTasks" asp-route-requestId="@dataShareRequestId">Return to summary</a>
                                } *@

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>