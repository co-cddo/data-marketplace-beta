@using Cddo.Data.Marketplace.Api.Dto.Responses.RequestAccess
@using Cddo.Data.Marketplace.UI.Controllers
@model List<OrganisationAccessResponse>

@{
    ViewData["Title"] = "Manage - Organisation approvals";
}

<a class="govuk-back-link" href="javascript:window.history.back()">Back</a>

<div class="govuk-main-wrapper">
    <h1 class="govuk-heading-l">
        <span class="govuk-caption-l">Request access</span>
        Manage organisation access
    </h1>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="govuk-tabs" data-module="govuk-tabs">
                <h2 class="govuk-tabs__title">Contents</h2>
                <ul class="govuk-tabs__list">
                    <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                        <a class="govuk-tabs__tab" href="#pending-requests">Pending</a>
                    </li>
                    <li class="govuk-tabs__list-item">
                        <a class="govuk-tabs__tab" href="#approved-requests">Approved</a>
                    </li>
                    <li class="govuk-tabs__list-item">
                        <a class="govuk-tabs__tab" href="#rejected-requests">Rejected</a>
                    </li>
                </ul>

                <!-- Pending Requests Tab -->
                <div class="govuk-tabs__panel" id="pending-requests">
                    <h2 class="govuk-heading-l">Pending Requests</h2>
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Organisation</th>
                                <th scope="col" class="govuk-table__header">Created</th>
                                <th scope="col" class="govuk-table__header">Status</th>
                                <th scope="col" class="govuk-table__header">Action</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var organisation in Model.Where(o => o.Status == "Pending"))
                            {
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">@organisation.OrganisationName</th>
                                    <td class="govuk-table__cell">@organisation.CreatedDate</td> 
                                    <td class="govuk-table__cell">@organisation.Status</td>
                                    <td class="govuk-table__cell">
                                        <a class="govuk-link" asp-controller="RequestAccess" asp-action="@nameof(RequestAccessController.GetOrganisationRequest)" asp-route-organisationRequestID="@organisation.OrganisationRequestID">Manage</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Approved Requests Tab -->
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="approved-requests">
                    <h2 class="govuk-heading-l">Approved Requests</h2>
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Organisation</th>
                                <th scope="col" class="govuk-table__header">Created</th>
                                <th scope="col" class="govuk-table__header">Updated</th>
                                <th scope="col" class="govuk-table__header">Status</th>
                                <th scope="col" class="govuk-table__header">Action</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var organisation in Model.Where(o => o.Status == "Approved"))
                            {
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">@organisation.OrganisationName</th>
                                    <td class="govuk-table__cell">@organisation.CreatedDate</td>
                                    <td class="govuk-table__cell">@organisation.UpdatedDate</td>
                                    <td class="govuk-table__cell">@organisation.Status</td>
                                    <td class="govuk-table__cell">
                                        <a class="govuk-link" asp-controller="RequestAccess" asp-action="@nameof(RequestAccessController.GetOrganisationRequest)" asp-route-organisationRequestID="@organisation.OrganisationRequestID">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Rejected Requests Tab -->
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="rejected-requests">
                    <h2 class="govuk-heading-l">Rejected Requests</h2>
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Organisation</th>
                                <th scope="col" class="govuk-table__header">Created</th>
                                <th scope="col" class="govuk-table__header">Updated</th>
                                <th scope="col" class="govuk-table__header">Status</th>
                                <th scope="col" class="govuk-table__header">Action</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var organisation in Model.Where(o => o.Status == "Rejected"))
                            {
                                <tr class="govuk-table__row">
                                    <th scope="row" class="govuk-table__header">@organisation.OrganisationName</th>
                                    <td class="govuk-table__cell">@organisation.CreatedDate</td>
                                    <td class="govuk-table__cell">@organisation.UpdatedDate</td>
                                    <td class="govuk-table__cell">@organisation.Status</td>
                                    <td class="govuk-table__cell">
                                        <a class="govuk-link" asp-controller="RequestAccess" asp-action="@nameof(RequestAccessController.GetOrganisationRequest)" asp-route-organisationRequestID="@organisation.OrganisationRequestID">view</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
