@using Cddo.Data.Marketplace.Api.Dto.Responses.ManageUser
@using Cddo.Data.Marketplace.UI.Configuration
@using Cddo.Data.Marketplace.UI.Controllers


@model ManageDepartmentsResponse
@{
    ViewData["Title"] = "Manage - Departments";
    const int maxMiddlePages = 3;
    var middleStart = Math.Max(1, Model.CurrentPage - maxMiddlePages / 2);
    var middleEnd = Math.Min((int)Model.TotalPages!, middleStart + maxMiddlePages - 1);
    middleStart = Math.Max(1, middleEnd - maxMiddlePages + 1);
}
<div class="govuk-width-container">
    <a href="/Manage" class="govuk-back-link">Back</a>

    <div class="govuk-main-wrapper">
        <h1 class="govuk-heading-xl">
            <span class="govuk-caption-l">Manage Departments</span>
            Departments
        </h1>
        <form asp-controller="ManageDepartment" asp-action="@nameof(ManageDepartmentController.GetDepartments)" method="get">
            <div class="govuk-grid-row mb-4">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-form-group search-input">
                        <label class="govuk-label" for="search">
                            Search Department
                        </label>
                        <div class="govuk-input__wrapper">
                            <input class="govuk-input" id="searchTerm" name="@nameof(@Model.SearchTerm)" aria-label="Search for organisations" type="text" spellcheck="false" autocomplete="off" value="@ViewBag.SearchTerm">
                            <button title="searchBtn" class="search-button" aria-label="Search for organisations" type="submit" enterkeyhint="searchTerm">
                                <svg class="search-button__icon" width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                                    <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
                                    <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="govuk-grid-column-one-third">
                    <a asp-controller="ManageDepartment" asp-action="GetAddDepartments" class="govuk-button govuk-button--secondary float-end mt-4" data-module="govuk-button">Add Department</a>
                </div>
            </div>

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-four-quarters">
                    <div class="d-flex justify-content-between">
                        <h3 class="govuk-heading-s mb-0">
                            @Model.TotalCount results

                        </h3>
                        <div class="govuk-form-group mb-0 d-inline-flex">
                            <div class="govuk-form-group">
                                <label for="pageSize" class="govuk-label">Results Per Page</label>
                                <div class="govuk-input__wrapper">
                                    <select class="govuk-input" id="pageSize" aria-label="Select results per page" name="@nameof(@Model.PageSize)" style="min-width:2.6em;">
                                        @foreach (var pageSizeOption in new[] { 10, 20, 50, 100 })
                                        {
                                            if (Model.PageSize == pageSizeOption)
                                            {
                                                <option value="@pageSizeOption" selected>@pageSizeOption</option>
                                            }
                                            else
                                            {
                                                <option value="@pageSizeOption">@pageSizeOption</option>
                                            }
                                        }
                                    </select>
                                    <button class="govuk-button govuk-button--secondary govuk-input__suffix mb-0"  style="max-width:5em;">
                                        Apply
                                        <span class="govuk-visually-hidden">
                                            results per page
                                        </span>

                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Department</th>
                                <th scope="col" class="govuk-table__header">Creation Date</th>
                                <th scope="col" class="govuk-table__header">Created By</th>
                                <th scope="col" class="govuk-table__header">Action</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @if (Model?.Departments != null && Model.Departments.Any())
                            {
                                @foreach (var department in Model.Departments)
                                {
                                    <tr class="govuk-table__row">
                                        <td class="govuk-table__cell">@department.DepartmentName</td>
                                        <td class="govuk-table__cell">@DateTimeExtensions.ToDateStringAsDDMMYYYY(department.Created)</td>
                                        <td class="govuk-table__cell">@department.CreatedByName</td>
                                        <td class="govuk-table__cell">
                                            <a class="govuk-link" href="/Manage/ManageDepartment?id=@department.Id">
                                                Manage
                                                <span class="govuk-visually-hidden">
                                                    @department.DepartmentName
                                                </span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="govuk-table__cell">No organisations available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>


                    @if (@Model?.TotalCount > 0)
                    {
                        <nav class="govuk-pagination" role="navigation" aria-label="Pagination">
                            @if (@Model?.CurrentPage != 1)
                            {
                                <div class="govuk-pagination__prev">
                                    <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(@Model.PageNumber)" value="@(@Model?.CurrentPage - 1)" rel="prev">
                                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                            <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                                        </svg>
                                        <span class="govuk-pagination__link-title">
                                            <strong>Previous</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
                                    </button>
                                </div>
                            }
                            <ul class="govuk-pagination__list">
                                @if (middleStart > 1)
                                {
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(@Model.PageNumber)" value="1">1</button>
                                    </li>
                                    @if (middleStart > 2)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                }

                                @for (int i = middleStart; i <= middleEnd; i++)
                                {
                                    <li class="govuk-pagination__item @(i == Model?.CurrentPage ? "govuk-pagination__item--current" : "")">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(@Model.PageNumber)" value="@i">@i</button>
                                    </li>
                                }

                                @if (middleEnd < Model?.TotalPages)
                                {
                                    @if (middleEnd < Model?.TotalPages - 1)
                                    {
                                        <li class="govuk-pagination__item govuk-pagination__item--ellipses">...</li>
                                    }
                                    <li class="govuk-pagination__item">
                                        <span class="govuk-visually-hidden">Page</span>

                                        <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(@Model.PageNumber)" value="@Model?.TotalPages">@Model?.TotalPages</button>
                                    </li>
                                }
                            </ul>

                            @if (@Model?.CurrentPage != Model?.TotalPages)
                            {
                                <div class="govuk-pagination__next">
                                    <button type="submit" class="govuk-link govuk-pagination__link" name="@nameof(@Model.PageNumber)" value="@(Model?.CurrentPage + 1)" rel="next">
                                        <span class="govuk-pagination__link-title">
                                            <strong>Next</strong><span class="govuk-visually-hidden"> page</span>
                                        </span>
                                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                            <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </nav>
                    }
                </div>
            </div>
        </form>
    </div>
</div>